
# ==========================================
# SCHOOL MANAGEMENT SYSTEM - .gitignore
# Django + PostgreSQL SaaS Project
# ==========================================

# 1. Python Virtual Environments
venv/
.venv/
env/
ENV/

# 2. Python Cache and Compiled Files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 3. Environment Variables and Secrets
.env
.env.*
!.env.example
*.pem
*.key

# 4. Local Databases
db.sqlite3
db.sqlite3-*
*.sqlite3
*.sqlite3-*
*.sqlite
*.db

# 5. Database Backups and Exports
backups/
*.sql
*.sql.gz
*.dump
*.backup
*.bak

# 6. Django Generated Files
staticfiles/
media/

# 7. Logs and Temporary Files
*.log
logs/
tmp/
temp/
*.tmp

# 8. IDE and Editor Settings
.vscode/
.idea/
*.swp
*.swo

# 9. Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# 10. Repomix Output
repomix-output.xml
repomix-output.*

# 11. Build and Packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# 12. Local Configuration Overrides
settings_local.py
local_settings.py

/database_backups/

# Development snapshots and temporary test artifacts
*_step[0-9]*_backup*
*.step[0-9]*_backup*
*_step[0-9]*_before_*
*.step[0-9]*_before_*
step[0-9]*_test.py
step[0-9]*_pdf_test.py
step[0-9]*_download_test.py
step[0-9]*_report_card_test.py
step[0-9]*_unconfigured_subject_test.py
step[0-9]*_missing_required_test.py
step[0-9]*_optional_grade_test.py
step[0-9]*_cross_school_report_test.py
step[0-9]*_finalize_curriculum_test.py
step[0-9]*_pdf_diagnostic.py
report_card_step[0-9]*.pdf
/release_format_backups/
