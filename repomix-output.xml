<file path="core/templates/core/change_password.html">
{% extends 'core/student_base.html' %}

{% block content %}
<div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-md mt-10">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <span>🔒</span> Change Password
    </h2>

    <form method="POST" class="space-y-4">
        {% csrf_token %}
        
        {{ form.non_field_errors }}
        
        {% for field in form %}
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">{{ field.label }}</label>
                {{ field }}
                {% if field.errors %}
                    <p class="text-red-500 text-xs mt-1">{{ field.errors.0 }}</p>
                {% endif %}
                {% if field.help_text %}
                    <p class="text-gray-500 text-xs mt-1">{{ field.help_text|safe }}</p>
                {% endif %}
            </div>
        {% endfor %}

        <button type="submit" class="w-full bg-indigo-600 text-white py-2 px-4 rounded-lg hover:bg-indigo-700 transition font-semibold mt-4">
            Update Password
        </button>
    </form>
    
    <div class="mt-4 text-center">
        <a href="{% url 'student_dashboard' %}" class="text-sm text-indigo-600 hover:underline">← Back to Dashboard</a>
    </div>
</div>
{% endblock %}
</file>

<file path="core/templates/core/class_students.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Class Students - School Management System</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 30px; }
        .container { max-width: 1000px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); }
        h1 { color: #38bdf8; margin-top: 0; font-size: 22px; }
        p { color: #94a3b8; }
        .back-link { display: inline-block; margin-bottom: 20px; color: #38bdf8; text-decoration: none; font-size: 14px; }
        .back-link:hover { text-decoration: underline; }
        table { width: 100%; border-collapse: collapse; background: #0f172a; border-radius: 8px; overflow: hidden; margin-top: 20px; }
        th, td { padding: 12px 16px; text-align: left; }
        th { background: #334155; color: #cbd5e1; font-size: 13px; text-transform: uppercase; }
        td { border-bottom: 1px solid #1e293b; color: #e2e8f0; font-size: 14px; }
        .profile-link { color: #38bdf8; text-decoration: none; font-weight: 500; }
        .profile-link:hover { text-decoration: underline; }
        .btn { display: inline-block; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 13px; margin-bottom: 20px; }
        .btn-success { background: #059669; color: white; }
        .btn-success:hover { background: #047857; }
        .badge { padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; display: inline-block; margin-right: 2px; }
        .badge-present { background: #065f46; color: #34d399; }
        .badge-absent { background: #7f1d1d; color: #f87171; }
        .badge-late { background: #78350f; color: #fbbf24; }
    </style>
</head>
<body>
    <div class="container">
        <a href="{% url 'teacher_dashboard' %}" class="back-link">&larr; Back to Dashboard</a>
        <div>
            <a href="{% url 'take_attendance' assignment.id %}" class="btn btn-success">Take Attendance</a>
        </div>
        
        <h1>Students in {{ class_stream.name }}</h1>
        <p>Subject Context: <strong>{{ assignment.subject.name }}</strong> | Term: <strong>{{ assignment.term }}</strong></p>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name & Reg No.</th>
                    <th>CAT / Exam / Total</th>
                    <th>Attendance (P / A / L)</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for item in student_data %}
                <tr>
                    <td>{{ forloop.counter }}</td>
                    <td>
                        <strong>{{ item.student.first_name }} {{ item.student.last_name }}</strong><br>
                        <span style="color: #94a3b8; font-size: 12px;">{{ item.student.registration_number }}</span>
                    </td>
                    <td>
                        {% if item.grade %}
                            {{ item.grade.marks_obtained }} ({{ item.grade.grade_letter }})
                        {% else %}
                            <span style="color: #64748b; font-size: 13px;">Not Graded</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge badge-present" title="Present">{{ item.present }}P</span>
                        <span class="badge badge-absent" title="Absent">{{ item.absent }}A</span>
                        <span class="badge badge-late" title="Late">{{ item.late }}L</span>
                    </td>
                    <td>
                        <a href="{% url 'student_academic_profile' item.student.id %}" class="profile-link">View Academic Profile</a>
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="5" style="text-align: center; padding: 30px; color: #64748b;">No students found enrolled in this class stream.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>
</html>
</file>

<file path="core/templates/core/daily_collection_report.html">
{% load humanize %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Daily Collection Report - {{ report_date }}</title>
    <style>
        body { font-family: Arial, sans-serif; color: #333; margin: 40px; }
        .header { text-align: center; border-bottom: 2px solid #003366; padding-bottom: 15px; margin-bottom: 25px; }
        .header h2 { margin: 0; color: #003366; }
        .filter-section { margin-bottom: 20px; background: #f9f9f9; padding: 15px; border-radius: 5px; }
        .summary-cards { display: flex; gap: 20px; margin-bottom: 25px; }
        .card { flex: 1; background: #f1f5f9; padding: 15px; border-radius: 5px; border-left: 4px solid #003366; }
        .card h4 { margin: 0 0 5px 0; color: #555; font-size: 14px; }
        .card p { margin: 0; font-size: 20px; font-weight: bold; color: #003366; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 14px; }
        th { background-color: #003366; color: white; }
        .print-btn { margin-top: 20px; padding: 10px 20px; background: #003366; color: white; border: none; cursor: pointer; border-radius: 4px; }
        @media print { .print-btn, .filter-section { display: none; } }
    </style>
</head>
<body>

    <div class="header">
        <h2>SCHOOL MANAGEMENT SYSTEM</h2>
        <p>Daily Cash & Collection Reconciliation Report</p>
    </div>

    <!-- Date Filter Form -->
    <div class="filter-section">
        <form method="GET" action="">
            <label for="date"><strong>Select Report Date:</strong></label>
            <input type="date" id="date" name="date" value="{{ report_date|date:'Y-m-d' }}" style="padding: 6px; margin-left: 10px;">
            <button type="submit" style="padding: 6px 15px; background: #003366; color: white; border: none; border-radius: 4px; cursor: pointer; margin-left: 10px;">Filter Date</button>
        </form>
    </div>

    <div class="summary-cards">
        <div class="card">
            <h4>Total Collections ({{ report_date|date:"d M Y" }})</h4>
            <p>{{ total_collection|floatformat:0|intcomma }} RWF</p>
        </div>
        <div class="card">
            <h4>Total Transactions</h4>
            <p>{{ total_transactions }}</p>
        </div>
        <div class="card">
            <h4>Prepared By</h4>
            <p style="font-size: 16px; margin-top: 4px;">{{ request.user.username|title }}</p>
        </div>
    </div>

    <h3>Collections Breakdown by Method</h3>
    <table>
        <thead>
            <tr>
                <th>Payment Method</th>
                <th>Total Collected</th>
            </tr>
        </thead>
        <tbody>
            {% for summary in method_summaries %}
            <tr>
                <td>{{ summary.payment_method }}</td>
                <td><strong>{{ summary.total|floatformat:0|intcomma }} RWF</strong></td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="2" style="text-align: center; color: #777;">No collections recorded for this date.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 style="margin-top: 30px;">Detailed Transaction List</h3>
    <table>
        <thead>
            <tr>
                <th>Receipt No</th>
                <th>Time</th>
                <th>Student</th>
                <th>Method</th>
                <th>Reference</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            {% for payment in payments %}
            <tr>
                <td>{{ payment.receipt_number|default:"N/A" }}</td>
                <td>{{ payment.date_paid|date:"H:i" }}</td>
                <td>{{ payment.student }} ({{ payment.student.registration_number }})</td>
                <td>{{ payment.payment_method }}</td>
                <td>{{ payment.reference_number|default:"N/A" }}</td>
                <td>{{ payment.amount_paid|floatformat:0|intcomma }} RWF</td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="6" style="text-align: center; color: #777;">No transactions found for this date.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <button class="print-btn" onclick="window.print()">Print / Export Report</button>

</body>
</html>
</file>

<file path="core/templates/core/daily_collections.html">
{% load humanize %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Daily Collections Report | SMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
    <div class="min-h-screen flex flex-col">
        <!-- Top Nav -->
        <header class="bg-blue-900 text-white shadow">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <h1 class="text-xl font-bold">Accountant Portal — Daily Collections</h1>
                <div class="space-x-3">
                    <a href="{% url 'debtors_list' %}" class="bg-blue-800 text-sm px-3 py-1 rounded hover:bg-blue-700 transition">Debtors List</a>
                    <a href="{% url 'accountant_dashboard' %}" class="bg-blue-800 text-sm px-3 py-1 rounded hover:bg-blue-700 transition">Dashboard</a>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full space-y-6">
            <!-- Filter & Summary Bar -->
            <div class="bg-white rounded-lg shadow p-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <form method="GET" class="flex items-center gap-3">
                    <label for="date" class="text-sm font-medium text-gray-700">Select Date:</label>
                    <input type="date" id="date" name="date" value="{{ selected_date|date:'Y-m-d' }}" class="border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                    <button type="submit" class="bg-blue-600 text-white text-sm px-4 py-2 rounded-lg hover:bg-blue-700 transition">Filter</button>
                </form>

                <div class="text-right">
                    <span class="text-xs text-gray-500 uppercase tracking-wider block">Total Collected for Date</span>
                    <span class="text-2xl font-bold text-green-600">{{ total_collected|floatformat:0|intcomma }} RWF</span>
                </div>
            </div>

            <!-- Transaction Table -->
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <div class="p-6 border-b">
                    <h3 class="text-lg font-semibold text-gray-800">Transactions on {{ selected_date|date:"d F Y" }}</h3>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Receipt No</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Method</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount Paid</th>
                                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for payment in payments %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-blue-900">{{ payment.receipt_number|default:"N/A" }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <a href="{% url 'student_financial_profile' payment.student.id %}" class="hover:text-blue-600 hover:underline">
                                        {{ payment.student }}
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">{{ payment.date_paid|date:"H:i" }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                    {{ payment.get_payment_method_display|default:payment.payment_method }}
                                    {% if payment.reference_number %}
                                    <span class="block text-xs text-gray-400">Ref: {{ payment.reference_number }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-green-600 font-semibold">{{ payment.amount_paid|floatformat:0|intcomma }} RWF</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                    <a href="{% url 'payment_receipt' payment.id %}" target="_blank" class="text-blue-600 hover:text-blue-900 bg-blue-50 px-3 py-1 rounded transition">Receipt</a>
                                </td>
                            </tr>
                            {% empty %}
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-center text-sm text-gray-500">
                                    No financial collections recorded for this date.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
</file>

