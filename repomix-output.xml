{% extends 'core/student_base.html' %}

{% block title %}Student Dashboard{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Student Dashboard</h1>
            <p class="text-sm text-gray-500 mt-1">Class Stream: <span class="font-medium text-indigo-600">{{ class_stream.name|default:"Not Assigned" }}</span></p>
        </div>
        <div class="text-right">
            <span class="inline-block bg-indigo-50 text-indigo-700 text-xs px-3 py-1.5 rounded-full font-semibold uppercase tracking-wider">Active Term</span>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center space-x-4">
            <div class="p-3 bg-indigo-50 text-indigo-600 rounded-lg">
                <i class="fas fa-book-open text-2xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-500">Pending Homework</p>
                <h3 class="text-2xl font-bold text-gray-800">{{ homework_count }}</h3>
            </div>
        </div>

        <!-- Dynamic Attendance Status Card with Percentage -->
        <a href="{% url 'student_attendance' %}" class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between hover:border-indigo-200 transition">
            <div class="flex items-center space-x-4">
                <div class="p-3 {{ bg_color }} rounded-lg">
                    <i class="fas {{ icon_class }} text-2xl"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Attendance Status</p>
                    <div class="flex items-baseline space-x-2">
                        <h3 class="text-2xl font-bold {{ status_color }}">{{ attendance_status }}</h3>
                        <span class="text-xs text-gray-400 font-semibold">({{ attendance_percentage|floatformat:1 }}%)</span>
                    </div>
                </div>
            </div>
            <i class="fas fa-chevron-right text-gray-300"></i>
        </a>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center space-x-4">
            <div class="p-3 bg-yellow-50 text-yellow-600 rounded-lg">
                <i class="fas fa-bullhorn text-2xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-500">Notices</p>
                <h3 class="text-2xl font-bold text-gray-800">{{ notice_count }} Active</h3>
            </div>
        </div>
    </div>

    <!-- Notices Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-gray-800">School Notices & Announcements</h3>
            <span class="text-xs bg-yellow-50 text-yellow-700 font-semibold px-2.5 py-1 rounded-full">{{ notice_count }} Available</span>
        </div>

        {% if recent_notices %}
            <div class="divide-y divide-gray-100">
                {% for notice in recent_notices %}
                    <div class="py-4 first:pt-0 last:pb-0">
                        <div class="flex justify-between items-start">
                            <h4 class="font-semibold text-gray-800 text-base">{{ notice.title }}</h4>
                            <span class="text-xs text-gray-400">{{ notice.created_at|date:"M d, Y" }}</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-1 whitespace-pre-line">{{ notice.content }}</p>
                        <div class="mt-2">
                            {% if notice.target_class %}
                                <span class="inline-block bg-blue-50 text-blue-700 text-xs px-2 py-0.5 rounded font-medium">Class Specific</span>
                            {% else %}
                                <span class="inline-block bg-green-50 text-green-700 text-xs px-2 py-0.5 rounded font-medium">School Wide</span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-gray-500 text-sm py-4">No active notices at the moment.</p>
        {% endif %}
    </div>

    <!-- Recent Homework Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-gray-800">Recent Homework Assignments</h3>
            <a href="{% url 'student_homework' %}" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">View All →</a>
        </div>

        {% if recent_homeworks %}
            <div class="divide-y divide-gray-100">
                {% for hw in recent_homeworks %}
                    <div class="py-3 flex justify-between items-center">
                        <div>
                            <h4 class="font-semibold text-gray-800">{{ hw.title }}</h4>
                            <p class="text-xs text-gray-500">Due: {{ hw.due_date }} | Subject: {{ hw.assignment.subject.name }}</p>
                        </div>
                        <a href="{% url 'student_homework' %}" class="px-3 py-1.5 bg-indigo-50 text-indigo-600 rounded-lg text-xs font-semibold hover:bg-indigo-100 transition">View Details</a>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-gray-500 text-sm py-4">No recent homework found for your class stream.</p>
        {% endif %}
    </div>
</div>
{% endblock %}

