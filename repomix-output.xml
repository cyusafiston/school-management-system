        .cal-present { background: rgba(34, 197, 94, 0.2); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.4); }
        .cal-late { background: rgba(234, 179, 8, 0.2); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.4); }
        .cal-absent { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); }

        .print-btn { background: #38bdf8; color: #0f172a; border: none; padding: 8px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 14px; }
        .print-btn:hover { background: #0ea5e9; }

        @media print {
            body { background: white; color: black; padding: 0; }
            .container { background: white; box-shadow: none; border: none; width: 100%; padding: 0; }
            .back-link, .print-btn, .tab-buttons, .calendar-nav-btn { display: none; }
            .tab-content { display: block !important; margin-bottom: 40px; }
            table, .calendar-grid { background: white; color: black; border: 1px solid #ccc; }
            th, .calendar-grid th { background: #f1f5f9; color: black; }
            td, .calendar-grid td { border: 1px solid #ddd; color: black; background: white !important; }
            .card, .calendar-header { background: #f8fafc; border: 1px solid #cbd5e1; color: black; }
            .card-title, .day-number { color: #64748b; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-row">
            <div>
                <h1>Attendance Tracker</h1>
                <p style="color: #94a3b8; font-size: 13px; margin: 4px 0 0 0;">
                    Student: <strong style="color: #38bdf8;">{{ student_profile.first_name }} {{ student_profile.last_name }}</strong> &bull; <span>{{ student_profile.registration_number }}</span>
                </p>
            </div>
            <div>
                <a href="{% url 'student_report_card' %}" class="print-btn" style="text-decoration: none; display: inline-block;">Download / Print PDF</a>
                <a href="{% url 'student_dashboard' %}" class="back-link" style="margin-left: 15px;">&larr; Back to Dashboard</a>
            </div>
        </div>

        <!-- Tab Switches -->
        <div class="tab-buttons">
            <button class="tab-btn active" onclick="switchTab(event, 'calendarTab')">🗓️ Visual Calendar</button>
            <button class="tab-btn" onclick="switchTab(event, 'dailyTab')">📅 Daily Table Log</button>
            <button class="tab-btn" onclick="switchTab(event, 'subjectTab')">📚 Subject-Wise Attendance</button>
        </div>

        <!-- TAB 1: VISUAL CALENDAR -->
        <div id="calendarTab" class="tab-content active">
            <div class="calendar-header">
                <a href="?year={{ prev_year }}&month={{ prev_month }}" class="calendar-nav-btn">&larr; Previous Month</a>
                <h3 style="margin: 0; color: #38bdf8; font-size: 18px;">{{ month_name }} {{ current_year }}</h3>
                <a href="?year={{ next_year }}&month={{ next_month }}" class="calendar-nav-btn">Next Month &rarr;</a>
            </div>

            <table class="calendar-grid">
                <thead>
                    <tr>
                        <th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th>
                    </tr>
                </thead>
                <tbody>
                    {% for week in month_days %}
                    <tr>
                        {% for day in week %}
                            {% if day == 0 %}
                                <td class="empty"></td>
                            {% else %}
                                <td>
                                    <span class="day-number">{{ day }}</span>
                                    {% with status=attendance_map|get_item:day %}
                                        {% if status == 'Present' %}
                                            <span class="cal-badge cal-present">Present</span>
                                        {% elif status == 'Late' %}
                                            <span class="cal-badge cal-late">Late</span>
                                        {% elif status == 'Absent' %}
                                            <span class="cal-badge cal-absent">Absent</span>
                                        {% endif %}
                                    {% endwith %}
                                </td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- TAB 2: DAILY ATTENDANCE TABLE -->
        <div id="dailyTab" class="tab-content">
            <div class="metrics-grid">
                <div class="card">
                    <div class="card-title">Daily Rate</div>
                    <div class="card-value" style="color: #38bdf8;">{{ daily_percentage }}%</div>
                </div>
                <div class="card">
                    <div class="card-title">Days Present</div>
                    <div class="card-value" style="color: #22c55e;">{{ daily_present }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Days Late</div>
                    <div class="card-value" style="color: #eab308;">{{ daily_late }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Days Absent</div>
                    <div class="card-value" style="color: #ef4444;">{{ daily_absent }}</div>
                </div>
            </div>

            <div style="font-weight: bold; margin-bottom: 10px;">Daily Attendance Log ({{ daily_total }} Total Days)</div>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Class Stream</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in daily_attendance %}
                    <tr>
                        <td>{{ record.date|date:"M d, Y" }}</td>
                        <td>{{ record.current_class.name }}</td>
                        <td>
                            {% if record.status == 'Present' %}
                                <span class="badge-present">Present</span>
                            {% elif record.status == 'Late' %}
                                <span class="badge-late">Late</span>
                            {% else %}
                                <span class="badge-absent">Absent</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 30px; color: #64748b;">No daily attendance records found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- TAB 3: SUBJECT ATTENDANCE -->
        <div id="subjectTab" class="tab-content">
            <div class="metrics-grid">
                <div class="card">
                    <div class="card-title">Subject Rate</div>
                    <div class="card-value" style="color: #38bdf8;">{{ sub_percentage }}%</div>
                </div>
                <div class="card">
                    <div class="card-title">Present Sessions</div>
                    <div class="card-value" style="color: #22c55e;">{{ sub_present }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Late Sessions</div>
                    <div class="card-value" style="color: #eab308;">{{ sub_late }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Absent Sessions</div>
                    <div class="card-value" style="color: #ef4444;">{{ sub_absent }}</div>
                </div>
            </div>

            <div style="font-weight: bold; margin-bottom: 10px;">Subject Session Log ({{ sub_total }} Total Sessions)</div>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Subject / Course</th>
                        <th>Teacher</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in subject_attendance %}
                    <tr>
                        <td>{{ record.date|date:"M d, Y" }}</td>
                        <td><strong>{{ record.assignment.subject.name }}</strong></td>
                        <td style="color: #94a3b8;">{{ record.assignment.teacher.username|default:"N/A" }}</td>
                        <td>
                            {% if record.status == 'Present' %}
                                <span class="badge-present">Present</span>
                            {% elif record.status == 'Late' %}
                                <span class="badge-late">Late</span>
                            {% else %}
                                <span class="badge-absent">Absent</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 30px; color: #64748b;">No subject attendance records found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    <script>
        function switchTab(evt, tabName) {
            let contents = document.getElementsByClassName("tab-content");
            for (let c of contents) { c.classList.remove("active"); }

            let buttons = document.getElementsByClassName("tab-btn");
            for (let b of buttons) { b.classList.remove("active"); }

            document.getElementById(tabName).classList.add("active");
            evt.currentTarget.classList.add("active");
        }
    </script>
</body>
</html>

==================================================

