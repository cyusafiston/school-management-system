                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Class</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Expected Fees</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Paid Amount</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Balance Due</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for item in debtors %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <a href="{% url 'student_financial_profile' item.student.id %}" class="text-blue-600 hover:underline hover:text-blue-900">
                                        {{ item.student }}
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ item.class.name }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-700">{{ item.expected|floatformat:0|intcomma }} RWF</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-green-600 font-medium">{{ item.paid|floatformat:0|intcomma }} RWF</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-red-600 font-bold">{{ item.balance|floatformat:0|intcomma }} RWF</td>
                            </tr>
                            {% empty %}
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">
                                    No debtors found! All enrolled students have fully cleared their fees for this term. 🎉
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
</file>

