                        class="w-11 h-11 rounded-xl
                               bg-sky-50 text-sky-600
                               flex items-center justify-center"
                    >
                        <i class="fas fa-bullhorn text-lg"></i>
                    </div>

                    <span
                        class="text-xs font-semibold
                               px-2.5 py-1 rounded-full
