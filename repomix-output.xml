                                        {% elif grade.grade_letter == 'D' %} bg-orange-50 text-orange-700
                                        {% else %} bg-red-50 text-red-700 {% endif %}">
                                        {{ grade.remarks|default:"N/A" }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
