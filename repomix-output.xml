    .btn-attendance { background: #0d9488; }
    .btn-attendance:hover { background: #0f766e; color: white; }
</style>
{% endblock %}

{% block content %}
<div class="dashboard-container">
    <div class="header">
        <div>
            <h1>Welcome back, Teacher {{ request.user.username|title }}!</h1>
            <p>Current Active Term: <strong>{{ current_term|default:"Not Set" }}</strong></p>
        </div>
        
        <!-- Attendance Dropdown Module -->
        <div class="d-flex align-items-center">
            <div class="dropdown">
                <button class="btn btn-outline-info dropdown-toggle" type="button" id="attendanceDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="color: #38bdf8; border-color: #38bdf8;">
                    Attendance Module
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="attendanceDropdown">
                    <li><a class="dropdown-item" href="{% url 'take_daily_attendance' %}">Daily Class Roll Call</a></li>
                    <li><hr class="dropdown-divider border-secondary"></li>
                    <li><a class="dropdown-item" href="#">Subject/Assignment Attendance</a></li>
                </ul>
            </div>
        </div>
    </div>

    <h2>Your Assigned Classes & Subjects</h2>
    <table>
        <thead>
            <tr>
                <th>Subject</th>
                <th>Class Stream</th>
                <th>Term</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for assignment in assignments %}
            <tr>
                <td><strong>{{ assignment.subject.name }}</strong> <span style="color: #64748b; font-size: 12px;">({{ assignment.subject.code }})</span></td>
                <td>{{ assignment.current_class.name }}</td>
                <td>{{ assignment.term }}</td>
