<file path="core/templates/core/password_reset_confirm.html">
{% extends 'core/auth_base.html' %}
{% block page_title %}Set new password | School Management System{% endblock %}
{% block icon %}fa-lock-open{% endblock %}
{% block heading %}Set a new password{% endblock %}
{% block subheading %}Choose a strong password you haven't used before.{% endblock %}
{% block content %}
    {% if validlink %}
        {% if form.non_field_errors %}
            <div class="mb-5 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
                {% for error in form.non_field_errors %}<p>{{ error }}</p>{% endfor %}
            </div>
        {% endif %}
        <form method="post">
            {% csrf_token %}
            {% for field in form %}
                <div class="mb-5">
                    <label for="{{ field.id_for_label }}" class="block text-sm font-medium text-slate-300 mb-2">{{ field.label }}</label>
                    <div class="input-wrapper flex items-center bg-slate-950/70 border border-slate-600 rounded-xl transition-all duration-200">
                        <div class="pl-4 text-slate-500"><i class="fa-solid fa-lock"></i></div>
                        <input type="password" name="{{ field.html_name }}" id="{{ field.id_for_label }}" required
                               autocomplete="new-password"
                               class="w-full bg-transparent border-0 outline-none px-3 py-3.5 text-white placeholder-slate-600">
                    </div>
                    {% if field.help_text %}<p class="text-xs text-slate-500 mt-2">{{ field.help_text|safe }}</p>{% endif %}
                    {% if field.errors %}
                        <div class="mt-2 text-xs text-red-400">{% for error in field.errors %}<p>{{ error }}</p>{% endfor %}</div>
                    {% endif %}
                </div>
            {% endfor %}
            <button type="submit" class="login-button w-full text-white font-semibold py-3.5 px-5 rounded-xl transition-all duration-200">
                Set new password
            </button>
        </form>
    {% else %}
        <div class="rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-4 text-sm text-red-300 text-center">
            This reset link is invalid or has already been used.
        </div>
        <div class="mt-6 text-center">
            <a href="{% url 'password_reset' %}" class="text-sky-400 text-sm hover:underline">Request a new link</a>
        </div>
    {% endif %}
{% endblock %}
</file>

