            </div>

            <p class="text-sm text-gray-700 mb-4">
                Are you sure you want to void this payment? This action will reverse the transaction record and cannot be easily undone. A mandatory reason is required for audit purposes.
            </p>

            <form method="POST" class="space-y-4">
                {% csrf_token %}
                <div>
                    <label for="void_reason" class="block text-sm font-medium text-gray-700 mb-1">Reason for Voiding *</label>
                    <textarea name="void_reason" id="void_reason" rows="3" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none" placeholder="Provide a detailed reason for this reversal..."></textarea>
                </div>

                <div class="flex justify-end space-x-3">
                    <a href="{% url 'student_financial_profile' payment.student.id %}" class="bg-gray-200 text-gray-700 text-sm px-4 py-2 rounded hover:bg-gray-300 transition">Cancel</a>
                    <button type="submit" class="bg-red-600 text-white text-sm px-4 py-2 rounded hover:bg-red-700 transition">Confirm Void Payment</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
</file>

<file path="core/templates/student/finances.html">
