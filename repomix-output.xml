                                </span>

                            </td>


                            <td class="px-6 py-4 text-center">

                                <span
                                    class="inline-flex items-center
                                           justify-center
                                           w-9 h-9
                                           rounded-full
                                           bg-indigo-50
                                           text-indigo-700
                                           text-sm font-bold"
                                >
                                    {{ row.grade_letter }}
                                </span>

                            </td>


                            <td
                                class="px-6 py-4
                                       text-sm text-slate-500"
                            >
                                {{ row.remarks }}
                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>


        <!-- Mobile Subject Cards -->
        <div class="md:hidden divide-y divide-slate-100">

            {% for row in table_rows %}

                <div class="p-5">

                    <div class="flex items-center justify-between">

                        <div class="flex items-center gap-3">

                            <div
                                class="w-9 h-9 rounded-lg
                                       bg-indigo-50
                                       text-indigo-600
                                       flex items-center justify-center"
                            >
                                <i class="fas fa-book text-sm"></i>
                            </div>

                            <div>

                                <p class="text-sm font-semibold text-slate-800">
                                    {{ row.subject_name }}
                                </p>

                                <p class="text-xs text-slate-400 mt-0.5">
                                    {{ row.remarks }}
                                </p>

                            </div>

                        </div>


                        <span
                            class="w-9 h-9 rounded-full
                                   bg-indigo-50
                                   text-indigo-700
                                   flex items-center justify-center
                                   text-sm font-bold"
                        >
                            {{ row.grade_letter }}
                        </span>

                    </div>


                    <div class="mt-4">

                        <div
                            class="flex items-center
                                   justify-between
                                   text-xs mb-2"
                        >

                            <span class="text-slate-500">
                                Performance
                            </span>

                            <span class="font-semibold text-slate-700">
                                {{ row.final_percentage|floatformat:1 }}%
                            </span>

                        </div>


                        <div
                            class="h-2
                                   bg-slate-100
                                   rounded-full overflow-hidden"
                        >

                            <div
                                class="h-full bg-indigo-500 rounded-full"
                                style="width: {{ row.final_percentage }}%;"
                            ></div>

                        </div>

                    </div>

                </div>

            {% endfor %}

        </div>

    </section>

    {% endif %}


    <!-- ========================================================= -->
    <!-- FOOTER MESSAGE -->
    <!-- ========================================================= -->

    <div class="text-center py-2">

        <p class="text-xs text-slate-400">
            Keep learning, stay consistent, and keep moving forward.
        </p>

    </div>

</div>

{% endblock %}
</file>

<file path="core/templates/core/student_financial_profile.html">
{% load humanize %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ student }} - Financial Profile | SMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
    <div class="min-h-screen flex flex-col">
        <!-- Top Nav -->
        <header class="bg-blue-900 text-white shadow">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <h1 class="text-xl font-bold">Accountant Portal — Student Financial Profile</h1>
                <div class="space-x-3">
                    <a href="{% url 'debtors_list' %}" class="bg-blue-800 text-sm px-3 py-1 rounded hover:bg-blue-700 transition">Debtors List</a>
                    <a href="{% url 'accountant_dashboard' %}" class="bg-blue-800 text-sm px-3 py-1 rounded hover:bg-blue-700 transition">Dashboard</a>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full space-y-6">
            <!-- Student Header Card -->
            <div class="bg-white rounded-lg shadow p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">{{ student }}</h2>
                    <p class="text-sm text-gray-500">Registration No: <span class="font-medium text-gray-700">{{ student.registration_number }}</span></p>
                </div>
                <div class="flex gap-4 text-sm bg-gray-50 p-3 rounded-lg border">
                    <div>
                        <span class="text-gray-500 block">Class Stream:</span>
                        <span class="font-semibold text-gray-800">{{ enrollment.class_stream.name|default:"Not Assigned" }}</span>
                    </div>
                    <div class="border-l pl-4">
                        <span class="text-gray-500 block">Active Term:</span>
                        <span class="font-semibold text-gray-800">{{ term.name|default:"N/A" }}</span>
                    </div>
                </div>
            </div>

            <!-- Financial Summary Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-6 rounded-lg shadow border-l-4 border-blue-600">
                    <p class="text-sm text-gray-500 font-medium">Expected Fees (Term)</p>
                    <p class="text-2xl font-bold text-gray-900 mt-1">{{ expected|floatformat:0|intcomma }} RWF</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow border-l-4 border-green-600">
                    <p class="text-sm text-gray-500 font-medium">Total Paid (Term)</p>
                    <p class="text-2xl font-bold text-green-600 mt-1">{{ paid|floatformat:0|intcomma }} RWF</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow border-l-4 border-red-600">
                    <p class="text-sm text-gray-500 font-medium">Outstanding Balance</p>
                    <p class="text-2xl font-bold text-red-600 mt-1">{{ balance|floatformat:0|intcomma }} RWF</p>
                </div>
            </div>

            <!-- Transaction History Ledger -->
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <div class="p-6 border-b flex justify-between items-center">
                    <h3 class="text-lg font-semibold text-gray-800">Payment Transaction History</h3>
                    <a href="{% url 'record_payment' %}" class="bg-blue-600 text-white text-sm px-4 py-2 rounded hover:bg-blue-700 transition">Record New Payment</a>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Receipt No</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Term / Year</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Method & Reference</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount Paid</th>
                                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for payment in payments %}
                            <tr class="{% if payment.is_voided %}bg-red-50 text-gray-400{% endif %}">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold {% if payment.is_voided %}line-through text-red-400{% else %}text-blue-900{% endif %}">
                                    {{ payment.receipt_number|default:"N/A" }}
                                    {% if payment.is_voided %}
                                        <span class="block text-xs font-normal text-red-600 uppercase">Voided</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm {% if payment.is_voided %}line-through{% else %}text-gray-600{% endif %}">{{ payment.date_paid|date:"d/m/Y H:i" }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm {% if payment.is_voided %}line-through{% else %}text-gray-600{% endif %}">{{ payment.term.name }} ({{ payment.academic_year.name }})</td>
                                <td class="px-6 py-4 text-sm {% if payment.is_voided %}line-through{% else %}text-gray-600{% endif %}">
                                    <span class="font-medium text-gray-800">{{ payment.get_payment_method_display|default:payment.payment_method }}</span>
                                    {% if payment.reference_number %}
                                    <span class="block text-xs text-gray-400">Ref: {{ payment.reference_number }}</span>
                                    {% endif %}
                                    
                                    <!-- Audit trail details displayed right under the transaction details -->
                                    {% if payment.is_voided %}
                                        <div class="mt-1 text-xs text-gray-500 space-y-0.5 font-normal">
                                            {% if payment.void_reason %}
                                                <p class="text-red-600 italic"><strong>Reason:</strong> {{ payment.void_reason }}</p>
                                            {% endif %}
                                            {% if payment.voided_by %}
                                                <p><strong>Voided By:</strong> {{ payment.voided_by.username }}</p>
                                            {% endif %}
                                            {% if payment.voided_at %}
                                                <p><strong>Voided At:</strong> {{ payment.voided_at|date:"d/m/Y H:i" }}</p>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-right {% if payment.is_voided %}line-through text-red-400{% else %}text-green-600 font-semibold{% endif %}">{{ payment.amount_paid|floatformat:0|intcomma }} RWF</td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium space-x-2">
                                    <a href="{% url 'payment_receipt' payment.id %}" target="_blank" class="text-blue-600 hover:text-blue-900 bg-blue-50 px-3 py-1 rounded transition inline-block">View Receipt</a>
                                    
                                    {% if not payment.is_voided %}
                                        <a href="{% url 'void_payment' payment.id %}" class="text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded transition inline-block">Void</a>
                                    {% else %}
                                        <span class="text-xs text-gray-400 italic">Reversed</span>
                                    {% endif %}
                                    <a href="{% url 'student_financial_statement' student.id %}" class="btn btn-secondary" target="_blank">Print Financial Statement</a>
                                </td>
                            </tr>
                            {% empty %}
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-center text-sm text-gray-500">
                                    No payment transactions recorded for this student yet.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
</file>

<file path="core/templates/core/student_grades.html">
{% extends 'core/student_base.html' %}

{% block title %}My Grades & Report Card{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Academic Gradebook</h1>
            <p class="text-sm text-gray-500 mt-1">Review your finalized performance scores and remarks per subject.</p>
        </div>
        <div>
            <a href="{% url 'student_dashboard' %}" class="px-4 py-2 bg-gray-50 text-gray-700 rounded-lg text-sm font-semibold hover:bg-gray-100 transition border border-gray-200">
                ← Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Grades Table Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-lg font-bold text-gray-800">Finalized Term Grades</h3>
            <span class="text-xs bg-indigo-50 text-indigo-700 font-semibold px-3 py-1 rounded-full">{{ grades_list|length }} Subjects Recorded</span>
        </div>

        {% if grades_list %}
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-600 text-xs uppercase tracking-wider font-semibold border-b border-gray-100">
                            <th class="py-3.5 px-6">Subject</th>
                            <th class="py-3.5 px-4 text-center">Term</th>
                            <th class="py-3.5 px-4 text-center">CAT</th>
                            <th class="py-3.5 px-4 text-center">Exam</th>
                            <th class="py-3.5 px-4 text-center">Total</th>
                            <th class="py-3.5 px-4 text-center">Percentage</th>
                            <th class="py-3.5 px-4 text-center">Grade</th>
                            <th class="py-3.5 px-6">Remarks</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                        {% for grade in grades_list %}
                            <tr class="hover:bg-gray-50/50 transition">
                                <td class="py-4 px-6 font-semibold text-gray-800">{{ grade.subject.name }}</td>
                                <td class="py-4 px-4 text-center text-gray-500">{{ grade.term.name }}</td>
                                <td class="py-4 px-4 text-center text-gray-600">{{ grade.cat_marks }}</td>
                                <td class="py-4 px-4 text-center text-gray-600">{{ grade.exam_marks }}</td>
                                <td class="py-4 px-4 text-center font-medium text-gray-800">{{ grade.marks_obtained }} / {{ grade.max_marks }}</td>
                                <td class="py-4 px-4 text-center font-semibold text-indigo-600">{{ grade.percentage|floatformat:1 }}%</td>
                                <td class="py-4 px-4 text-center">
                                    <span class="inline-block w-8 h-8 leading-8 rounded-full font-bold text-xs 
                                        {% if grade.grade_letter == 'A' %} bg-green-100 text-green-700
                                        {% elif grade.grade_letter == 'B' %} bg-blue-100 text-blue-700
                                        {% elif grade.grade_letter == 'C' %} bg-yellow-100 text-yellow-700
                                        {% elif grade.grade_letter == 'D' %} bg-orange-100 text-orange-700
                                        {% else %} bg-red-100 text-red-700 {% endif %}">
                                        {{ grade.grade_letter }}
                                    </span>
                                </td>
                                <td class="py-4 px-6">
                                    <span class="text-xs px-2.5 py-1 rounded-md font-medium
                                        {% if grade.grade_letter == 'A' %} bg-green-50 text-green-700
                                        {% elif grade.grade_letter == 'B' %} bg-blue-50 text-blue-700
                                        {% elif grade.grade_letter == 'C' %} bg-yellow-50 text-yellow-700
                                        {% elif grade.grade_letter == 'D' %} bg-orange-50 text-orange-700
                                        {% else %} bg-red-50 text-red-700 {% endif %}">
                                        {{ grade.remarks|default:"N/A" }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-12 px-4">
                <div class="text-gray-300 mb-2"><i class="fas fa-file-invoice text-4xl"></i></div>
                <h4 class="text-gray-700 font-semibold">No Finalized Grades Available</h4>
                <p class="text-gray-500 text-sm mt-1">Your teachers have not finalized or published any grade records for your account yet.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
</file>

<file path="core/templates/core/student_homework.html">
{% extends 'core/student_base.html' %}

{% block title %}My Homework{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Homework Assignments</h1>
            <p class="text-sm text-gray-500 mt-1">Class Stream: <span class="font-medium text-indigo-600">{{ student_profile.current_class.name|default:"Not Assigned" }}</span></p>
        </div>
    </div>

    <!-- Homework List Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">All Class Homework</h3>

        {% if homework_list %}
            <div class="space-y-4">
                {% for hw in homework_list %}
                    <div class="p-4 border border-gray-100 rounded-lg bg-gray-50 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <span class="inline-block bg-indigo-50 text-indigo-700 text-xs px-2.5 py-1 rounded-md font-semibold mb-2">
                                {{ hw.assignment.subject.name }}
                            </span>
                            <h4 class="text-base font-bold text-gray-800">{{ hw.title }}</h4>
                            <p class="text-sm text-gray-600 mt-1">{{ hw.description }}</p>
                            <p class="text-xs text-gray-400 mt-2"><i class="far fa-clock mr-1"></i> Due Date: {{ hw.due_date }}</p>
                        </div>
                        
                        {% if hw.file %}
                            <a href="{{ hw.file.url }}" download class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-700 transition flex items-center space-x-2">
                                <i class="fas fa-download"></i>
                                <span>Download File</span>
                            </a>
                        {% else %}
                            <span class="text-xs text-gray-400 italic">No attachment</span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8">
                <div class="text-gray-300 text-4xl mb-2"><i class="fas fa-folder-open"></i></div>
                <p class="text-gray-500 text-sm">No homework assignments posted for your class yet.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
</file>

<file path="core/templates/core/student_statement.html">
{% load humanize %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Financial Statement - {{ student }}</title>
    <style>
        body { font-family: Arial, sans-serif; color: #333; margin: 40px; }
        .header { text-align: center; border-bottom: 2px solid #003366; padding-bottom: 15px; margin-bottom: 25px; }
        .header h2 { margin: 0; color: #003366; }
        .student-info { margin-bottom: 20px; background: #f9f9f9; padding: 15px; border-radius: 5px; }
        .student-info table { width: 100%; border-collapse: collapse; }
        .student-info td { padding: 5px; }
        table.ledger { width: 100%; border-collapse: collapse; margin-top: 20px; }
        table.ledger th, table.ledger td { border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 14px; }
        table.ledger th { background-color: #003366; color: white; }
        table.ledger td.amount { text-align: right; font-weight: 600; }
        .voided { background-color: #fff5f5; color: #c53030; text-decoration: line-through; }
        .summary-box { margin-top: 30px; float: right; width: 300px; background: #f1f5f9; padding: 15px; border-radius: 5px; }
        .summary-box table { width: 100%; }
        .summary-box td { padding: 6px; }
        .summary-box td.amount { text-align: right; font-variant-numeric: tabular-nums; }
        .print-btn { margin-top: 20px; padding: 10px 20px; background: #003366; color: white; border: none; cursor: pointer; border-radius: 4px; }
        @media print { .print-btn { display: none; } }
    </style>
</head>
<body>

    <div class="header">
        <h2>SCHOOL MANAGEMENT SYSTEM</h2>
        <p>Official Student Financial Statement & Ledger History</p>
    </div>

    <div class="student-info">
        <table>
            <tr>
                <td><strong>Student Name:</strong> {{ student.first_name }} {{ student.last_name }}</td>
                <td><strong>Registration No:</strong> {{ student.registration_number }}</td>
            </tr>
            <tr>
                <td><strong>Current Class:</strong> {{ student.current_class|default:"N/A" }}</td>
                <td><strong>Statement Date:</strong> {% now "d/m/Y" %}</td>
            </tr>
        </table>
    </div>

    <h3>Transaction Ledger History</h3>
    <table class="ledger">
        <thead>
            <tr>
                <th>Receipt No</th>
                <th>Date</th>
                <th>Term</th>
                <th>Method</th>
                <th>Reference</th>
                <th>Amount Paid</th>
                <th>Status / Notes</th>
            </tr>
        </thead>
        <tbody>
            {% for payment in payments %}
            <tr class="{% if payment.is_voided %}voided{% endif %}">
                <td>{{ payment.receipt_number|default:"N/A" }}</td>
                <td>{{ payment.date_paid|date:"d/m/Y H:i" }}</td>
                <td>{{ payment.term }}</td>
                <td>{{ payment.payment_method }}</td>
                <td>{{ payment.reference_number|default:"N/A" }}</td>
                <td class="amount">{{ payment.amount_paid|floatformat:0|intcomma }} RWF</td>
                <td>
                    {% if payment.is_voided %}
                        <strong>VOIDED</strong> (Reason: {{ payment.void_reason }})
                    {% else %}
                        Active
                    {% endif %}
                </td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="7" style="text-align: center; color: #777;">No payment transactions recorded yet.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="summary-box">
        <table>
            <tr>
                <td><strong>Total Expected:</strong></td>
                <td class="amount">{{ total_expected|floatformat:0|intcomma }} RWF</td>
            </tr>
            <tr>
                <td><strong>Total Paid (Valid):</strong></td>
                <td class="amount" style="color: green;">{{ total_paid|floatformat:0|intcomma }} RWF</td>
            </tr>
            <tr>
                <td><strong>Outstanding Balance:</strong></td>
                <td class="amount" style="color: red;"><strong>{{ outstanding_balance|floatformat:0|intcomma }} RWF</strong></td>
            </tr>
        </table>
    </div>

    <div style="clear: both;"></div>

    <button class="print-btn" onclick="window.print()">Print / Export Statement</button>

</body>
</html>
</file>

<file path="core/templates/core/take_attendance.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Take Attendance - School Management System</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 30px; }
        .container { max-width: 900px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); }
        h1 { color: #38bdf8; margin-top: 0; font-size: 22px; }
        p { color: #94a3b8; }
        .back-link { display: inline-block; margin-bottom: 20px; color: #38bdf8; text-decoration: none; font-size: 14px; }
        .back-link:hover { text-decoration: underline; }
        table { width: 100%; border-collapse: collapse; background: #0f172a; border-radius: 8px; overflow: hidden; margin-top: 20px; }
        th, td { padding: 12px 16px; text-align: left; }
        th { background: #334155; color: #cbd5e1; font-size: 13px; text-transform: uppercase; }
        td { border-bottom: 1px solid #1e293b; color: #e2e8f0; font-size: 14px; }
        .date-box { background: #0f172a; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #334155; }
        input[type="date"] { padding: 8px; background: #1e293b; border: 1px solid #475569; color: white; border-radius: 4px; }
        input[type="date"]:focus { border-color: #38bdf8; outline: none; }
        .status-group { display: flex; gap: 10px; }
        .status-btn { padding: 6px 12px; border-radius: 4px; border: 1px solid #475569; background: #1e293b; color: #cbd5e1; cursor: pointer; font-size: 13px; font-weight: 600; }
        .status-input:checked + label.present { background: #22c55e; border-color: #22c55e; color: white; }
        .status-input:checked + label.late { background: #eab308; border-color: #eab308; color: white; }
        .status-input:checked + label.absent { background: #ef4444; border-color: #ef4444; color: white; }
        .save-btn { margin-top: 25px; background: #22c55e; color: white; padding: 10px 20px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 15px; }
        .save-btn:hover { background: #16a34a; }
    </style>
</head>
<body>
    <div class="container">
        <a href="{% url 'class_students' assignment.id %}" class="back-link">&larr; Back to Students</a>
        <h1>Take Attendance</h1>
        <p>Class: <strong>{{ assignment.current_class.name }}</strong> | Subject: <strong>{{ assignment.subject.name }}</strong></p>

        <!-- Date Selector Form -->
        <form method="GET" class="date-box">
            <label for="date" style="font-weight: bold; margin-right: 10px; font-size: 14px;">Select Date:</label>
            <input type="date" id="date" name="date" value="{{ attendance_date }}" onchange="this.form.submit()">
        </form>

        <!-- Attendance Submission Form -->
        <form method="POST">
            {% csrf_token %}
            <input type="hidden" name="attendance_date" value="{{ attendance_date }}">
            
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student Name</th>
                        <th>Reg Number</th>
                        <th style="text-align: center;">Status (Present / Late / Absent)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in student_data %}
                    <tr>
                        <td>{{ forloop.counter }}</td>
                        <td><strong>{{ item.student.first_name }} {{ item.student.last_name }}</strong></td>
                        <td style="color: #94a3b8; font-size: 13px;">{{ item.student.registration_number }}</td>
                        <td style="text-align: center;">
                            <div style="display: inline-flex; gap: 8px;">
                                <!-- Present Radio -->
                                <input type="radio" class="status-input" name="status_{{ item.student.id }}" id="present_{{ item.student.id }}" value="Present" {% if item.status == 'Present' %}checked{% endif %} style="display:none;">
                                <label for="present_{{ item.student.id }}" class="status-btn present" style="{% if item.status == 'Present' %}background: #22c55e; border-color: #22c55e; color: white;{% endif %}">Present</label>

                                <!-- Late Radio -->
                                <input type="radio" class="status-input" name="status_{{ item.student.id }}" id="late_{{ item.student.id }}" value="Late" {% if item.status == 'Late' %}checked{% endif %} style="display:none;">
                                <label for="late_{{ item.student.id }}" class="status-btn late" style="{% if item.status == 'Late' %}background: #eab308; border-color: #eab308; color: white;{% endif %}">Late</label>

                                <!-- Absent Radio -->
                                <input type="radio" class="status-input" name="status_{{ item.student.id }}" id="absent_{{ item.student.id }}" value="Absent" {% if item.status == 'Absent' %}checked{% endif %} style="display:none;">
                                <label for="absent_{{ item.student.id }}" class="status-btn absent" style="{% if item.status == 'Absent' %}background: #ef4444; border-color: #ef4444; color: white;{% endif %}">Absent</label>
                            </div>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 30px; color: #64748b;">No students found in this class stream.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if student_data %}
            <button type="submit" class="save-btn">Save Attendance</button>
            {% endif %}
        </form>
    </div>

    <!-- Simple script to make custom radio buttons toggle colors nicely when clicked -->
    <script>
        document.querySelectorAll('.status-btn').forEach(label => {
            label.addEventListener('click', function() {
                const group = this.parentElement;
                group.querySelectorAll('.status-btn').forEach(btn => {
                    btn.style.background = '#1e293b';
                    btn.style.borderColor = '#475569';
                    btn.style.color = '#cbd5e1';
                });
                if (this.classList.contains('present')) {
                    this.style.background = '#22c55e';
                    this.style.borderColor = '#22c55e';
                } else if (this.classList.contains('late')) {
                    this.style.background = '#eab308';
                    this.style.borderColor = '#eab308';
                } else if (this.classList.contains('absent')) {
                    this.style.background = '#ef4444';
                    this.style.borderColor = '#ef4444';
                }
                this.style.color = 'white';
            });
        });
    </script>
</body>
</html>
</file>

<file path="core/templates/core/take_daily_attendance.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Take Daily Class Attendance - School Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 30px; }
        .dashboard-container { max-width: 1000px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 20px; margin-bottom: 25px; flex-wrap: wrap; gap: 15px; }
        h1 { color: #38bdf8; margin: 0; font-size: 24px; }
        p { color: #94a3b8; margin: 5px 0 0 0; }
        .back-btn { padding: 8px 16px; background: #334155; color: white; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; transition: background 0.2s; }
        .back-btn:hover { background: #475569; color: white; }
        table { width: 100%; border-collapse: collapse; background: #0f172a; border-radius: 8px; overflow: hidden; margin-top: 10px; }
        th, td { padding: 14px 16px; text-align: left; }
        th { background: #334155; color: #cbd5e1; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; }
        td { border-bottom: 1px solid #1e293b; color: #e2e8f0; font-size: 14px; }
        tr:last-child td { border-bottom: none; }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="header">
            <div>
                <h1>Take Daily Class Roll Call</h1>
                <p>Date: <strong>{{ today }}</strong></p>
            </div>
            <a href="{% url 'teacher_dashboard' %}" class="back-btn">Back to Dashboard</a>
        </div>

        <!-- Class Stream Selection Buttons -->
        <div class="mb-4">
            <h5 style="color: #cbd5e1; font-size: 15px; margin-bottom: 10px;">Select Class Stream:</h5>
            <div class="d-flex flex-wrap gap-2">
                {% for class_obj in classes %}
                    <a href="{% url 'take_daily_attendance_class' class_obj.id %}" 
                       class="btn {% if selected_class and selected_class.id == class_obj.id %}btn-info text-dark fw-bold{% else %}btn-outline-secondary text-light{% endif %} btn-sm">
                       {{ class_obj.name }}
                    </a>
                {% endfor %}
            </div>
        </div>

        {% if selected_class %}
            <div class="card shadow-sm bg-dark border-secondary">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Class: {{ selected_class.name }}</h5>
                    {% if already_submitted %}
                        <span class="badge bg-warning text-dark">Locked (Already Submitted Today)</span>
                    {% else %}
                        <span class="badge bg-success">Open for Submission</span>
                    {% endif %}
                </div>
                
                <div class="card-body p-0">
                    <form method="POST">
                        {% csrf_token %}
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Student Name</th>
                                    <th>Attendance Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for student in students %}
                                <tr>
                                    <td>{{ forloop.counter }}</td>
                                    <td>{{ student }}</td>
                                    <td>
                                        {% if already_submitted %}
                                            {% with record=student.dailyclassattendance_set.all|dictsortreversed:"date"|first %}
                                                <span class="badge 
                                                    {% if record.status == 'Present' %}bg-success
                                                    {% elif record.status == 'Late' %}bg-warning text-dark
                                                    {% else %}bg-danger{% endif %}">
                                                    {{ record.status }}
                                                </span>
                                            {% endwith %}
                                        {% else %}
                                            <div class="btn-group" role="group">
                                                <input type="radio" class="btn-check" name="status_{{ student.id }}" id="present_{{ student.id }}" value="Present" checked>
                                                <label class="btn btn-outline-success btn-sm" for="present_{{ student.id }}">Present</label>

                                                <input type="radio" class="btn-check" name="status_{{ student.id }}" id="late_{{ student.id }}" value="Late">
                                                <label class="btn btn-outline-warning btn-sm" for="late_{{ student.id }}">Late</label>

                                                <input type="radio" class="btn-check" name="status_{{ student.id }}" id="absent_{{ student.id }}" value="Absent">
                                                <label class="btn btn-outline-danger btn-sm" for="absent_{{ student.id }}">Absent</label>
                                            </div>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% empty %}
                                <tr>
                                    <td colspan="3" class="no-data text-center text-muted py-4">No students found in this class stream.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>

                        {% if not already_submitted and students %}
                            <div class="p-3">
                                <button type="submit" class="btn btn-success w-100 fw-bold">Submit and Lock Attendance</button>
                            </div>
                        {% endif %}
                    </form>
                </div>
            </div>
        {% else %}
            <div class="alert alert-secondary text-light bg-dark border-secondary mt-3">Please select a class stream from above to take or view attendance.</div>
        {% endif %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</file>

<file path="core/templates/core/teacher_classes.html">
