<file path="core/templates/core/password_reset_form.html">
{% extends 'core/auth_base.html' %}
{% block page_title %}Reset Password | School Management System{% endblock %}
{% block icon %}fa-key{% endblock %}
{% block heading %}Forgot your password?{% endblock %}
{% block subheading %}Enter the email linked to your account and we'll send you a reset link.{% endblock %}
{% block content %}
    {% if form.non_field_errors %}
        <div class="mb-5 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">
            {% for error in form.non_field_errors %}<p>{{ error }}</p>{% endfor %}
        </div>
    {% endif %}
    <form method="post">
        {% csrf_token %}
        <div class="mb-6">
            <label for="{{ form.email.id_for_label }}" class="block text-sm font-medium text-slate-300 mb-2">Email address</label>
            <div class="input-wrapper flex items-center bg-slate-950/70 border border-slate-600 rounded-xl transition-all duration-200">
                <div class="pl-4 text-slate-500"><i class="fa-solid fa-envelope"></i></div>
                <input type="email" name="{{ form.email.html_name }}" id="{{ form.email.id_for_label }}" required autofocus
                       placeholder="you@example.com"
                       class="w-full bg-transparent border-0 outline-none px-3 py-3.5 text-white placeholder-slate-600">
            </div>
            {% if form.email.errors %}
                <div class="mt-2 text-xs text-red-400">{% for error in form.email.errors %}<p>{{ error }}</p>{% endfor %}</div>
            {% endif %}
        </div>
        <button type="submit" class="login-button w-full text-white font-semibold py-3.5 px-5 rounded-xl transition-all duration-200 flex items-center justify-center gap-2">
            <span>Send reset link</span>
            <i class="fa-solid fa-paper-plane"></i>
        </button>
    </form>
    <div class="mt-7 text-center">
        <p class="text-xs text-slate-500">No email on file, or you're a student?</p>
        <p class="text-xs text-slate-400 mt-1">Ask your school administrator to reset your password instead.</p>
        <p class="text-xs text-slate-500 mt-4">
            <a href="{% url 'login' %}" class="text-sky-400 hover:underline">← Back to login</a>
        </p>
    </div>
{% endblock %}
</file>

