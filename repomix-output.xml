<file path="core/templates/core/report_card_pdf.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Official Report Card</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; color: #1e293b; margin: 0; padding: 20px; font-size: 13px; }
        .header { text-align: center; border-bottom: 2px solid #38bdf8; padding-bottom: 10px; margin-bottom: 20px; }
        .school-name { font-size: 20px; font-weight: bold; color: #0f172a; margin: 0; }
        .report-title { font-size: 13px; text-transform: uppercase; color: #64748b; margin-top: 5px; }
        
        .student-info { width: 100%; margin-bottom: 20px; background: #f8fafc; padding: 10px; border-radius: 6px; border: 1px solid #e2e8f0; }
        .student-info td { padding: 5px 8px; font-size: 12px; }
        
        h3 { font-size: 14px; color: #0f172a; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-top: 20px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 8px; margin-bottom: 15px; }
        th, td { border: 1px solid #cbd5e1; padding: 8px 10px; text-align: left; font-size: 11px; }
        th { background: #f1f5f9; color: #0f172a; font-weight: bold; text-transform: uppercase; }
        
        .footer { margin-top: 30px; width: 100%; display: table; }
        .footer-left { display: table-cell; width: 50%; font-size: 11px; vertical-align: bottom; }
        .footer-right { display: table-cell; width: 50%; text-align: right; }
        .signature-box { border-top: 1px solid #94a3b8; width: 180px; text-align: center; padding-top: 5px; margin-left: auto; font-size: 11px; }
    </style>
</head>
<body>

    <div class="header">
        <h1 class="school-name">SCHOOL MANAGEMENT SYSTEM</h1>
        <div class="report-title">{{ report_title }}</div>
        <div style="font-size: 12px; color: #0284c7; font-weight: bold; margin-top: 4px;">{{ current_term }} &bull; ({{ date_range }})</div>
    </div>

    <table class="student-info">
        <tr>
            <td><strong>Student Name:</strong> {{ student_profile.first_name }} {{ student_profile.last_name }}</td>
            <td><strong>Registration No:</strong> {{ student_profile.registration_number }}</td>
        </tr>
        <tr>
            <td><strong>Current Class:</strong> {{ student_profile.current_class|default:"N/A" }}</td>
            <td><strong>Overall Attendance Rate:</strong> <span style="color: #0284c7;">{{ attendance_percentage }}%</span></td>
        </tr>
    </table>

    <h3>Academic Performance & Grades</h3>
    <table>
        <thead>
            <tr>
                <th>Subject / Course</th>
                {% if term_param == '2' or term_param == '3' or report_scope == 'annual' %}
                <th>Term 1 (%)</th>
                <th>Term 2 (%)</th>
                {% endif %}
                {% if term_param == '3' or report_scope == 'annual' %}
                <th>Term 3 (%)</th>
                <th>Final (%)</th>
                {% elif term_param == '1' %}
                <th>CAT Score</th>
                <th>Exam Score</th>
                <th>Total Score</th>
                <th>%</th>
                {% endif %}
                <th>Grade</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            {% for row in table_rows %}
            <tr>
                <td><strong>{{ row.subject_name }}</strong></td>
                
                {% if term_param == '2' or term_param == '3' or report_scope == 'annual' %}
                <td>{{ row.terms.1.percentage|default:"-"|floatformat:1 }}{% if row.terms.1 %}%{% endif %}</td>
                <td>{{ row.terms.2.percentage|default:"-"|floatformat:1 }}{% if row.terms.2 %}%{% endif %}</td>
                {% endif %}
                
                {% if term_param == '3' or report_scope == 'annual' %}
                <td>{{ row.terms.3.percentage|default:"-"|floatformat:1 }}{% if row.terms.3 %}%{% endif %}</td>
                <td style="font-weight: bold;">{{ row.final_percentage }}%</td>
                {% elif term_param == '1' %}
                <td>{{ row.terms.1.cat_marks|floatformat:0 }} / {{ row.terms.1.max_cat|floatformat:0 }}</td>
                <td>{{ row.terms.1.exam_marks|floatformat:0 }} / {{ row.terms.1.max_exam|floatformat:0 }}</td>
                <td>{{ row.terms.1.marks_obtained|floatformat:0 }} / {{ row.terms.1.max_marks|floatformat:0 }}</td>
                <td>{{ row.terms.1.percentage|floatformat:1 }}%</td>
                {% endif %}
                
                <td style="font-weight: bold; color: #0284c7;">{{ row.grade_letter }}</td>
                <td>{{ row.remarks }}</td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="7" style="text-align: center; color: #64748b; padding: 15px;">No academic grades recorded for this scope yet.</td>
            </tr>
            {% endfor %}
            
            {% if table_rows %}
            <tr style="background: #f8fafc; font-weight: bold;">
                <td>AVERAGE STANDING</td>
                {% if term_param == '2' or term_param == '3' or report_scope == 'annual' %}
                <td colspan="2"></td>
                {% endif %}
                {% if term_param == '3' or report_scope == 'annual' %}
                <td colspan="2"></td>
                {% elif term_param == '1' %}
                <td colspan="3"></td>
                {% endif %}
                <td style="color: #0284c7;">{{ average_percentage }}%</td>
                <td style="color: #0284c7;">{{ avg_grade_letter }}</td>
                <td>Overall Standing</td>
            </tr>
            {% endif %}
        </tbody>
    </table>

    <h3>Attendance Summary</h3>
    <table>
        <tr>
            <th>Total Logs</th>
            <th>Days Present</th>
            <th>Days Late</th>
            <th>Days Absent</th>
        </tr>
        <tr>
            <td>{{ total_records }}</td>
            <td style="color: #16a34a; font-weight: bold;">{{ present_count }}</td>
            <td style="color: #ca8a04; font-weight: bold;">{{ late_count }}</td>
            <td style="color: #dc2626; font-weight: bold;">{{ absent_count }}</td>
        </tr>
    </table>

    <div class="footer">
        <div class="footer-left">
            <p><strong>Issued on:</strong> {{ issue_date }}</p>
        </div>
        <div class="footer-right">
            <div class="signature-box">
                Authorized Signature / Stamp
            </div>
        </div>
    </div>
    <!-- Grading Scale Key -->
    <div style="margin-top: 25px; font-size: 11px; border: 1px solid #cbd5e1; padding: 10px; background: #f8fafc; border-radius: 4px;">
        <strong>GRADING SCALE:</strong> 
        A: 80–100 (Excellent) &bull; 
        B: 70–79 (Very Good) &bull; 
        C: 60–69 (Good) &bull; 
        D: 50–59 (Satisfactory) &bull; 
        F: 0–49 (Fail)
    </div>

    <!-- Signatures -->
    <div class="footer" style="margin-top: 40px; width: 100%;">
        <table style="width: 100%; border: none;">
            <tr>
                <td style="border: none; width: 50%;">
                    Class Teacher Signature:<br><br>
                    ___________________________
                </td>
                <td style="border: none; width: 50%; text-align: right;">
                    Head Teacher Signature & Stamp:<br><br>
                    ___________________________
                </td>
            </tr>
        </table>
    </div>

</body>
</html>
</file>

<file path="core/templates/core/student_attendance.html">
{% load custom_filters %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Attendance Tracker - SMS Portal</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 30px; }
        .container { max-width: 1100px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); }
        .header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        h1 { color: #38bdf8; margin: 0; font-size: 22px; }
        .back-link { color: #38bdf8; text-decoration: none; font-size: 14px; }
        .back-link:hover { text-decoration: underline; }
        
        /* Tabs styling */
        .tab-buttons { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #334155; padding-bottom: 15px; }
        .tab-btn { background: #0f172a; color: #94a3b8; border: 1px solid #334155; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; }
        .tab-btn.active { background: #38bdf8; color: #0f172a; border-color: #38bdf8; }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 25px; }
        .card { background: #0f172a; padding: 20px; border-radius: 8px; border: 1px solid #334155; }
        .card-title { font-size: 12px; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px; }
        .card-value { font-size: 24px; font-weight: bold; }
        
        table { width: 100%; border-collapse: collapse; background: #0f172a; border-radius: 8px; overflow: hidden; margin-top: 15px; }
        th, td { padding: 12px 16px; text-align: left; }
        th { background: #334155; color: #cbd5e1; font-size: 12px; text-transform: uppercase; }
        td { border-bottom: 1px solid #1e293b; color: #e2e8f0; font-size: 14px; }
        
        .badge-present { background: rgba(34, 197, 94, 0.15); color: #22c55e; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 12px; }
        .badge-late { background: rgba(234, 179, 8, 0.15); color: #eab308; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 12px; }
        .badge-absent { background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 12px; }

        /* Calendar Styles */
        .calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; background: #0f172a; padding: 15px; border-radius: 8px; border: 1px solid #334155; }
        .calendar-nav-btn { background: #334155; color: #f8fafc; border: none; padding: 6px 14px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 13px; }
        .calendar-nav-btn:hover { background: #38bdf8; color: #0f172a; }
        .calendar-grid { width: 100%; border-collapse: collapse; background: #0f172a; border-radius: 8px; overflow: hidden; border: 1px solid #334155; }
        .calendar-grid th { text-align: center; background: #334155; padding: 10px; color: #cbd5e1; font-size: 13px; width: 14.28%; }
        .calendar-grid td { height: 85px; vertical-align: top; border: 1px solid #1e293b; padding: 8px; text-align: right; position: relative; }
        .calendar-grid td.empty { background: #0b1120; opacity: 0.4; }
        .day-number { font-size: 13px; font-weight: bold; color: #94a3b8; display: block; margin-bottom: 5px; }
        .cal-badge { display: block; font-size: 11px; padding: 4px 6px; border-radius: 4px; text-align: center; font-weight: bold; margin-top: 4px; }
        .cal-present { background: rgba(34, 197, 94, 0.2); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.4); }
        .cal-late { background: rgba(234, 179, 8, 0.2); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.4); }
        .cal-absent { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); }

        .print-btn { background: #38bdf8; color: #0f172a; border: none; padding: 8px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 14px; }
        .print-btn:hover { background: #0ea5e9; }

        @media print {
            body { background: white; color: black; padding: 0; }
            .container { background: white; box-shadow: none; border: none; width: 100%; padding: 0; }
            .back-link, .print-btn, .tab-buttons, .calendar-nav-btn { display: none; }
            .tab-content { display: block !important; margin-bottom: 40px; }
            table, .calendar-grid { background: white; color: black; border: 1px solid #ccc; }
            th, .calendar-grid th { background: #f1f5f9; color: black; }
            td, .calendar-grid td { border: 1px solid #ddd; color: black; background: white !important; }
            .card, .calendar-header { background: #f8fafc; border: 1px solid #cbd5e1; color: black; }
            .card-title, .day-number { color: #64748b; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-row">
            <div>
                <h1>Attendance Tracker</h1>
                <p style="color: #94a3b8; font-size: 13px; margin: 4px 0 0 0;">
                    Student: <strong style="color: #38bdf8;">{{ student_profile.first_name }} {{ student_profile.last_name }}</strong> &bull; <span>{{ student_profile.registration_number }}</span>
                </p>
            </div>
            <div>
                <a href="{% url 'student_report_card' %}" class="print-btn" style="text-decoration: none; display: inline-block;">Download / Print PDF</a>
                <a href="{% url 'student_dashboard' %}" class="back-link" style="margin-left: 15px;">&larr; Back to Dashboard</a>
            </div>
        </div>

        <!-- Tab Switches -->
        <div class="tab-buttons">
            <button class="tab-btn active" onclick="switchTab(event, 'calendarTab')">🗓️ Visual Calendar</button>
            <button class="tab-btn" onclick="switchTab(event, 'dailyTab')">📅 Daily Table Log</button>
            <button class="tab-btn" onclick="switchTab(event, 'subjectTab')">📚 Subject-Wise Attendance</button>
        </div>

        <!-- TAB 1: VISUAL CALENDAR -->
        <div id="calendarTab" class="tab-content active">
            <div class="calendar-header">
                <a href="?year={{ prev_year }}&month={{ prev_month }}" class="calendar-nav-btn">&larr; Previous Month</a>
                <h3 style="margin: 0; color: #38bdf8; font-size: 18px;">{{ month_name }} {{ current_year }}</h3>
                <a href="?year={{ next_year }}&month={{ next_month }}" class="calendar-nav-btn">Next Month &rarr;</a>
            </div>

            <table class="calendar-grid">
                <thead>
                    <tr>
                        <th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th>
                    </tr>
                </thead>
                <tbody>
                    {% for week in month_days %}
                    <tr>
                        {% for day in week %}
                            {% if day == 0 %}
                                <td class="empty"></td>
                            {% else %}
                                <td>
                                    <span class="day-number">{{ day }}</span>
                                    {% with status=attendance_map|get_item:day %}
                                        {% if status == 'Present' %}
                                            <span class="cal-badge cal-present">Present</span>
                                        {% elif status == 'Late' %}
                                            <span class="cal-badge cal-late">Late</span>
                                        {% elif status == 'Absent' %}
                                            <span class="cal-badge cal-absent">Absent</span>
                                        {% endif %}
                                    {% endwith %}
                                </td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- TAB 2: DAILY ATTENDANCE TABLE -->
        <div id="dailyTab" class="tab-content">
            <div class="metrics-grid">
                <div class="card">
                    <div class="card-title">Daily Rate</div>
                    <div class="card-value" style="color: #38bdf8;">{{ daily_percentage }}%</div>
                </div>
                <div class="card">
                    <div class="card-title">Days Present</div>
                    <div class="card-value" style="color: #22c55e;">{{ daily_present }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Days Late</div>
                    <div class="card-value" style="color: #eab308;">{{ daily_late }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Days Absent</div>
                    <div class="card-value" style="color: #ef4444;">{{ daily_absent }}</div>
                </div>
            </div>

            <div style="font-weight: bold; margin-bottom: 10px;">Daily Attendance Log ({{ daily_total }} Total Days)</div>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Class Stream</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in daily_attendance %}
                    <tr>
                        <td>{{ record.date|date:"M d, Y" }}</td>
                        <td>{{ record.current_class.name }}</td>
                        <td>
                            {% if record.status == 'Present' %}
                                <span class="badge-present">Present</span>
                            {% elif record.status == 'Late' %}
                                <span class="badge-late">Late</span>
                            {% else %}
                                <span class="badge-absent">Absent</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 30px; color: #64748b;">No daily attendance records found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- TAB 3: SUBJECT ATTENDANCE -->
        <div id="subjectTab" class="tab-content">
            <div class="metrics-grid">
                <div class="card">
                    <div class="card-title">Subject Rate</div>
                    <div class="card-value" style="color: #38bdf8;">{{ sub_percentage }}%</div>
                </div>
                <div class="card">
                    <div class="card-title">Present Sessions</div>
                    <div class="card-value" style="color: #22c55e;">{{ sub_present }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Late Sessions</div>
                    <div class="card-value" style="color: #eab308;">{{ sub_late }}</div>
                </div>
                <div class="card">
                    <div class="card-title">Absent Sessions</div>
                    <div class="card-value" style="color: #ef4444;">{{ sub_absent }}</div>
                </div>
            </div>

            <div style="font-weight: bold; margin-bottom: 10px;">Subject Session Log ({{ sub_total }} Total Sessions)</div>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Subject / Course</th>
                        <th>Teacher</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in subject_attendance %}
                    <tr>
                        <td>{{ record.date|date:"M d, Y" }}</td>
                        <td><strong>{{ record.assignment.subject.name }}</strong></td>
                        <td style="color: #94a3b8;">{{ record.assignment.teacher.username|default:"N/A" }}</td>
                        <td>
                            {% if record.status == 'Present' %}
                                <span class="badge-present">Present</span>
                            {% elif record.status == 'Late' %}
                                <span class="badge-late">Late</span>
                            {% else %}
                                <span class="badge-absent">Absent</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 30px; color: #64748b;">No subject attendance records found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    <script>
        function switchTab(evt, tabName) {
            let contents = document.getElementsByClassName("tab-content");
            for (let c of contents) { c.classList.remove("active"); }

            let buttons = document.getElementsByClassName("tab-btn");
            for (let b of buttons) { b.classList.remove("active"); }

            document.getElementById(tabName).classList.add("active");
            evt.currentTarget.classList.add("active");
        }
    </script>
</body>
</html>
</file>

<file path="core/templates/core/student_base.html">
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Student Portal{% endblock %}</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Alpine.js -->
    <script defer
            src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>

<body class="bg-gray-50 font-sans">

<div class="flex h-screen overflow-hidden">

    <!-- =========================================================
         SIDEBAR
    ========================================================== -->
    <aside class="w-64 bg-indigo-900 text-white flex flex-col hidden md:flex">

        <!-- Logo / Portal Name -->
        <div class="px-6 py-5 text-2xl font-bold tracking-wider border-b border-indigo-800 flex items-center space-x-2">

            <i class="fas fa-graduation-cap text-indigo-400"></i>

            <span>SMS Portal</span>

        </div>


        <!-- Navigation -->
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">


            <!-- HOME -->
            <a href="{% url 'student_dashboard' %}"
               class="flex items-center px-4 py-3 rounded-lg transition
               {% if request.resolver_match.url_name == 'student_dashboard' %}
                   bg-indigo-700 text-white
               {% else %}
                   text-indigo-100 hover:bg-indigo-800
               {% endif %}">

                <i class="fas fa-home w-6"></i>

                <span>Home</span>

            </a>


            <!-- HOMEWORK -->
            <a href="{% url 'student_homework' %}"
               class="flex items-center px-4 py-3 rounded-lg transition
               {% if request.resolver_match.url_name == 'student_homework' %}
                   bg-indigo-700 text-white
               {% else %}
                   text-indigo-100 hover:bg-indigo-800
               {% endif %}">

                <i class="fas fa-book-open w-6"></i>

                <span>Homework</span>

            </a>


            <!-- ATTENDANCE -->
            <a href="{% url 'student_attendance' %}"
               class="flex items-center px-4 py-3 rounded-lg transition
               {% if request.resolver_match.url_name == 'student_attendance' %}
                   bg-indigo-700 text-white
               {% else %}
                   text-indigo-100 hover:bg-indigo-800
               {% endif %}">

                <i class="fas fa-calendar-check w-6"></i>

                <span>Attendance</span>

            </a>


            <!-- GRADES -->
            <a href="{% url 'student_grades' %}"
               class="flex items-center px-4 py-3 rounded-lg transition
               {% if request.resolver_match.url_name == 'student_grades' %}
                   bg-indigo-700 text-white
               {% else %}
                   text-indigo-100 hover:bg-indigo-800
               {% endif %}">

                <i class="fas fa-chart-line w-6"></i>

                <span>Grades</span>

            </a>


            <!-- =================================================
                 FINANCES
            ================================================== -->
            <a href="{% url 'student_finances' %}"
               class="flex items-center px-4 py-3 rounded-lg transition
               {% if request.resolver_match.url_name == 'student_finances' %}
                   bg-indigo-700 text-white
               {% else %}
                   text-indigo-100 hover:bg-indigo-800
               {% endif %}">

                <i class="fas fa-wallet w-6"></i>

                <span>Finances</span>

            </a>


            <!-- MESSAGES -->
            <a href="#"
               class="flex items-center px-4 py-3 rounded-lg text-indigo-100 hover:bg-indigo-800 transition">

                <i class="fas fa-envelope w-6"></i>

                <span>Messages</span>

            </a>


            <!-- CHANGE PASSWORD -->
            <a href="{% url 'change_password' %}"
               class="flex items-center px-4 py-3 rounded-lg transition
               {% if request.resolver_match.url_name == 'change_password' %}
                   bg-indigo-700 text-white
               {% else %}
                   text-indigo-100 hover:bg-indigo-800
               {% endif %}">

                <i class="fas fa-lock w-6"></i>

                <span>Change Password</span>

            </a>

        </nav>


        <!-- =====================================================
             LOGOUT
        ====================================================== -->
        <div class="p-4 border-t border-indigo-800">

            <form action="{% url 'logout' %}" method="post">

                {% csrf_token %}

                <button type="submit"
                        class="w-full flex items-center px-4 py-2 rounded-lg text-red-300 hover:bg-indigo-800 transition">

                    <i class="fas fa-sign-out-alt w-6"></i>

                    <span>Logout</span>

                </button>

            </form>

        </div>

    </aside>


    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->
    <div class="flex-1 flex flex-col overflow-hidden">


        <!-- =====================================================
             TOP HEADER
        ====================================================== -->
        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-6 z-10">


            <!-- Welcome -->
            <div class="flex items-center space-x-3">

                <span class="text-gray-700 font-semibold">
                    Welcome back,
                </span>

                <span class="text-indigo-900 font-bold">
                    {{ request.user.get_full_name|default:request.user.username }}
                </span>

            </div>


            <!-- Header right -->
            <div class="flex items-center space-x-4">


                <!-- =================================================
                     NOTIFICATIONS
                ================================================== -->
                <div class="relative" x-data="{ open: false }">

                    <!-- Bell -->
                    <button
                        @click="open = !open"
                        class="text-gray-500 hover:text-indigo-600 relative transition focus:outline-none">

                        <i class="fas fa-bell text-xl"></i>


                        {% if homework_count and homework_count > 0 %}

                            <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center font-bold">

                                {{ homework_count }}

                            </span>

                        {% else %}

                            <span class="absolute top-0 right-0 h-2 w-2 bg-red-500 rounded-full"></span>

                        {% endif %}

                    </button>


                    <!-- Notification Dropdown -->
                    <div
                        x-show="open"
                        @click.away="open = false"
                        class="absolute right-0 mt-3 w-80 bg-white rounded-xl shadow-lg border border-gray-100 py-3 z-50">


                        <!-- Header -->
                        <div class="px-4 pb-2 border-b border-gray-100 flex justify-between items-center">

                            <h4 class="font-bold text-gray-800 text-sm">
                                Notifications
                            </h4>

                            <span class="text-xs bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded-full font-semibold">

                                {{ homework_count|default:0 }} New

                            </span>

                        </div>


                        <!-- Notifications -->
                        <div class="divide-y divide-gray-50 max-h-64 overflow-y-auto">

                            {% if recent_homeworks %}

                                {% for hw in recent_homeworks %}

                                    <a href="{% url 'student_homework' %}"
                                       class="block px-4 py-3 hover:bg-gray-50 transition">

                                        <div class="flex items-start space-x-3">

                                            <div class="p-2 bg-indigo-50 text-indigo-600 rounded-lg text-xs">

                                                <i class="fas fa-book-open"></i>

                                            </div>

                                            <div>

                                                <p class="text-xs font-semibold text-gray-800">

                                                    {{ hw.title }}

                                                </p>

                                                <p class="text-[11px] text-gray-500 mt-0.5">

                                                    Due: {{ hw.due_date }}

                                                </p>

                                            </div>

                                        </div>

                                    </a>

                                {% endfor %}

                            {% else %}

                                <div class="px-4 py-6 text-center text-gray-400 text-xs">

                                    No new notifications right now.

                                </div>

                            {% endif %}

                        </div>


                        <!-- View all -->
                        <div class="px-4 pt-2 border-t border-gray-100 text-center">

                            <a href="{% url 'student_homework' %}"
                               class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">

                                View All Homework →

                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PROFILE AVATAR
                ================================================== -->
                <div class="flex items-center space-x-3 border-l pl-4 border-gray-200">

                    <div class="h-9 w-9 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold">

                        {{ request.user.username|slice:":1"|upper }}

                    </div>

                </div>

            </div>

        </header>


        <!-- =====================================================
             PAGE CONTENT
        ====================================================== -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 p-6">

            {% block content %}
            {% endblock %}

        </main>

    </div>

</div>

</body>
</html>
</file>

<file path="core/templates/core/student_dashboard.html">
{% extends 'core/student_base.html' %}

{% block title %}Student Dashboard{% endblock %}

{% block content %}

<div class="space-y-6">

    <!-- ========================================================= -->
