<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Official Report Card</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; color: #1e293b; margin: 0; padding: 20px; font-size: 13px; }
        .header { text-align: center; border-bottom: 2px solid #38bdf8; padding-bottom: 10px; margin-bottom: 20px; }
        .school-name { font-size: 20px; font-weight: bold; color: #0f172a; margin: 0; }
        .report-title { font-size: 13px; text-transform: uppercase; color: #64748b; margin-top: 5px; }
        
        .student-info { width: 100%; margin-bottom: 20px; background: #f8fafc; padding: 10px; border-radius: 6px; border: 1px solid #e2e8f0; }
        .student-info td { padding: 5px 8px; font-size: 12px; }
        
        h3 { font-size: 14px; color: #0f172a; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; margin-top: 20px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 8px; margin-bottom: 15px; }
        th, td { border: 1px solid #cbd5e1; padding: 8px 10px; text-align: left; font-size: 11px; }
        th { background: #f1f5f9; color: #0f172a; font-weight: bold; text-transform: uppercase; }
        
        .footer { margin-top: 30px; width: 100%; display: table; }
        .footer-left { display: table-cell; width: 50%; font-size: 11px; vertical-align: bottom; }
        .footer-right { display: table-cell; width: 50%; text-align: right; }
        .signature-box { border-top: 1px solid #94a3b8; width: 180px; text-align: center; padding-top: 5px; margin-left: auto; font-size: 11px; }
    </style>
</head>
<body>

    <div class="header">
        <h1 class="school-name">SCHOOL MANAGEMENT SYSTEM</h1>
        <div class="report-title">{{ report_title }}</div>
        <div style="font-size: 12px; color: #0284c7; font-weight: bold; margin-top: 4px;">{{ current_term }} &bull; ({{ date_range }})</div>
    </div>

    <table class="student-info">
        <tr>
            <td><strong>Student Name:</strong> {{ student_profile.first_name }} {{ student_profile.last_name }}</td>
            <td><strong>Registration No:</strong> {{ student_profile.registration_number }}</td>
        </tr>
        <tr>
            <td><strong>Current Class:</strong> {{ student_profile.current_class|default:"N/A" }}</td>
            <td><strong>Overall Attendance Rate:</strong> <span style="color: #0284c7;">{{ attendance_percentage }}%</span></td>
        </tr>
    </table>

    <h3>Academic Performance & Grades</h3>
    <table>
        <thead>
            <tr>
                <th>Subject / Course</th>
                {% if term_param == '2' or term_param == '3' or report_scope == 'annual' %}
                <th>Term 1 (%)</th>
                <th>Term 2 (%)</th>
                {% endif %}
                {% if term_param == '3' or report_scope == 'annual' %}
                <th>Term 3 (%)</th>
                <th>Final (%)</th>
                {% elif term_param == '1' %}
                <th>CAT Score</th>
                <th>Exam Score</th>
                <th>Total Score</th>
                <th>%</th>
                {% endif %}
                <th>Grade</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            {% for row in table_rows %}
            <tr>
                <td><strong>{{ row.subject_name }}</strong></td>
                
                {% if term_param == '2' or term_param == '3' or report_scope == 'annual' %}
                <td>{{ row.terms.1.percentage|default:"-"|floatformat:1 }}{% if row.terms.1 %}%{% endif %}</td>
                <td>{{ row.terms.2.percentage|default:"-"|floatformat:1 }}{% if row.terms.2 %}%{% endif %}</td>
                {% endif %}
                
                {% if term_param == '3' or report_scope == 'annual' %}
                <td>{{ row.terms.3.percentage|default:"-"|floatformat:1 }}{% if row.terms.3 %}%{% endif %}</td>
                <td style="font-weight: bold;">{{ row.final_percentage }}%</td>
                {% elif term_param == '1' %}
                <td>{{ row.terms.1.cat_marks|floatformat:0 }} / {{ row.terms.1.max_cat|floatformat:0 }}</td>
                <td>{{ row.terms.1.exam_marks|floatformat:0 }} / {{ row.terms.1.max_exam|floatformat:0 }}</td>
                <td>{{ row.terms.1.marks_obtained|floatformat:0 }} / {{ row.terms.1.max_marks|floatformat:0 }}</td>
                <td>{{ row.terms.1.percentage|floatformat:1 }}%</td>
                {% endif %}
                
                <td style="font-weight: bold; color: #0284c7;">{{ row.grade_letter }}</td>
                <td>{{ row.remarks }}</td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="7" style="text-align: center; color: #64748b; padding: 15px;">No academic grades recorded for this scope yet.</td>
            </tr>
            {% endfor %}
            
            {% if table_rows %}
            <tr style="background: #f8fafc; font-weight: bold;">
                <td>AVERAGE STANDING</td>
                {% if term_param == '2' or term_param == '3' or report_scope == 'annual' %}
                <td colspan="2"></td>
                {% endif %}
                {% if term_param == '3' or report_scope == 'annual' %}
                <td colspan="2"></td>
                {% elif term_param == '1' %}
                <td colspan="3"></td>
                {% endif %}
                <td style="color: #0284c7;">{{ average_percentage }}%</td>
                <td style="color: #0284c7;">{{ avg_grade_letter }}</td>
                <td>Overall Standing</td>
            </tr>
            {% endif %}
        </tbody>
    </table>

    <h3>Attendance Summary</h3>
    <table>
        <tr>
            <th>Total Logs</th>
            <th>Days Present</th>
            <th>Days Late</th>
            <th>Days Absent</th>
        </tr>
        <tr>
            <td>{{ total_records }}</td>
            <td style="color: #16a34a; font-weight: bold;">{{ present_count }}</td>
            <td style="color: #ca8a04; font-weight: bold;">{{ late_count }}</td>
            <td style="color: #dc2626; font-weight: bold;">{{ absent_count }}</td>
        </tr>
    </table>

    <div class="footer">
        <div class="footer-left">
            <p><strong>Issued on:</strong> {{ issue_date }}</p>
        </div>
        <div class="footer-right">
            <div class="signature-box">
                Authorized Signature / Stamp
            </div>
        </div>
    </div>
    <!-- Grading Scale Key -->
    <div style="margin-top: 25px; font-size: 11px; border: 1px solid #cbd5e1; padding: 10px; background: #f8fafc; border-radius: 4px;">
        <strong>GRADING SCALE:</strong> 
        A: 80–100 (Excellent) &bull; 
        B: 70–79 (Very Good) &bull; 
        C: 60–69 (Good) &bull; 
        D: 50–59 (Satisfactory) &bull; 
        F: 0–49 (Fail)
    </div>

    <!-- Signatures -->
    <div class="footer" style="margin-top: 40px; width: 100%;">
        <table style="width: 100%; border: none;">
            <tr>
                <td style="border: none; width: 50%;">
                    Class Teacher Signature:<br><br>
                    ___________________________
                </td>
                <td style="border: none; width: 50%; text-align: right;">
                    Head Teacher Signature & Stamp:<br><br>
                    ___________________________
                </td>
            </tr>
        </table>
    </div>

</body>
</html>

