                                               bg-indigo-50
                                               text-indigo-600
                                               flex items-center justify-center"
                                    >
                                        <i class="fas fa-book text-sm"></i>
                                    </div>

                                    <span
                                        class="text-sm font-semibold
                                               text-slate-800"
                                    >
                                        {{ row.subject_name }}
                                    </span>

                                </div>

                            </td>


                            <td class="px-6 py-4 text-center">

                                <span
                                    class="text-sm font-bold
                                           text-slate-800"
                                >
