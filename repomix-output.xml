<file path="core/templates/core/void_payment_confirm.html">
{% load humanize %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Void Payment - SMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
    <div class="min-h-screen flex flex-col items-center justify-center p-4">
        <div class="max-w-xl w-full bg-white rounded-lg shadow-md p-8">
            <h2 class="text-xl font-bold text-red-600 mb-4">Void Payment: {{ payment.receipt_number }}</h2>
            
            <div class="bg-gray-50 p-4 rounded-lg mb-6 space-y-2 text-sm">
                <p><strong>Student:</strong> {{ payment.student }}</p>
                <p><strong>Amount:</strong> {{ payment.amount_paid|floatformat:0|intcomma }} RWF</p>
                <p><strong>Payment Method:</strong> {{ payment.payment_method }}</p>
                <p><strong>Date Paid:</strong> {{ payment.date_paid|date:"d/m/Y H:i" }}</p>
            </div>

            <p class="text-sm text-gray-700 mb-4">
                Are you sure you want to void this payment? This action will reverse the transaction record and cannot be easily undone. A mandatory reason is required for audit purposes.
            </p>

            <form method="POST" class="space-y-4">
                {% csrf_token %}
                <div>
                    <label for="void_reason" class="block text-sm font-medium text-gray-700 mb-1">Reason for Voiding *</label>
                    <textarea name="void_reason" id="void_reason" rows="3" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none" placeholder="Provide a detailed reason for this reversal..."></textarea>
                </div>

                <div class="flex justify-end space-x-3">
                    <a href="{% url 'student_financial_profile' payment.student.id %}" class="bg-gray-200 text-gray-700 text-sm px-4 py-2 rounded hover:bg-gray-300 transition">Cancel</a>
                    <button type="submit" class="bg-red-600 text-white text-sm px-4 py-2 rounded hover:bg-red-700 transition">Confirm Void Payment</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
</file>

<file path="core/templates/student/finances.html">
{% extends 'core/student_base.html' %}

{% load humanize %}

{% block title %}My Finances{% endblock %}

{% block content %}

<div class="space-y-6">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <section
        class="relative overflow-hidden rounded-2xl
               bg-gradient-to-br from-indigo-600 via-indigo-600 to-blue-600
               text-white shadow-lg"
    >

        <!-- Decorative shapes -->
        <div class="absolute -top-20 -right-20 w-56 h-56 rounded-full bg-white/10"></div>
        <div class="absolute -bottom-24 -left-16 w-48 h-48 rounded-full bg-white/5"></div>

        <div class="relative px-6 py-7 sm:px-8">

            <div class="flex flex-col lg:flex-row
                        lg:items-center lg:justify-between
                        gap-6">

                <!-- Title -->
                <div>

                    <div class="flex items-center gap-2 mb-2">

                        <span class="text-indigo-200 text-sm font-medium">
                            Student Portal
                        </span>

                        <span class="w-1 h-1 rounded-full bg-indigo-300"></span>

                        <span class="text-indigo-200 text-sm">
                            Financial Account
                        </span>

                    </div>

                    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">
                        My Finances
                    </h1>

                    <p class="text-indigo-100 text-sm sm:text-base mt-2">
                        View your fees, payments, outstanding balance,
                        and receipts.
                    </p>

                </div>


                <!-- Actions -->
                <div class="flex flex-col sm:flex-row gap-3">

                    <a
                        href="{% url 'student_financial_statement' student.id %}"
                        target="_blank"
                        class="inline-flex items-center
                               justify-center gap-2
                               px-4 py-2.5
                               bg-white text-indigo-700
                               rounded-xl
                               text-sm font-semibold
                               shadow-sm
                               hover:bg-indigo-50
                               transition"
                    >
                        <i class="fas fa-file-invoice-dollar"></i>
                        Full Statement
                    </a>

                    <a
                        href="{% url 'student_dashboard' %}"
                        class="inline-flex items-center
                               justify-center gap-2
                               px-4 py-2.5
                               bg-white/10
                               border border-white/20
                               text-white
                               rounded-xl
                               text-sm font-semibold
                               hover:bg-white/20
                               transition"
                    >
                        <i class="fas fa-arrow-left text-xs"></i>
                        Dashboard
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- NO ACTIVE TERM -->
    <!-- ========================================================= -->

    {% if not current_term %}

        <section
            class="bg-amber-50
                   border border-amber-200
                   rounded-2xl
                   p-5"
        >

            <div class="flex items-start gap-4">

                <div
                    class="w-10 h-10 rounded-xl
                           bg-amber-100
                           text-amber-600
                           flex items-center justify-center
                           shrink-0"
                >
                    <i class="fas fa-triangle-exclamation"></i>
                </div>

                <div>

                    <h3 class="font-semibold text-amber-900">
                        No active term
                    </h3>

                    <p class="text-sm text-amber-800 mt-1">
                        No active term has been set yet. Fee and payment
                        information will appear once a term is active.
                    </p>

                </div>

            </div>

        </section>

    {% endif %}


    <!-- ========================================================= -->
    <!-- FINANCIAL SUMMARY -->
    <!-- ========================================================= -->

    <section>

        <div class="flex items-center justify-between mb-4">

            <div>

                <h2 class="text-lg font-bold text-slate-800">
                    Financial Overview
                </h2>

                <p class="text-sm text-slate-500 mt-1">
                    Your current financial position.
                </p>

            </div>

            {% if current_term %}

                <span
                    class="inline-flex items-center gap-2
                           bg-indigo-50
                           text-indigo-700
                           px-3 py-1.5
                           rounded-full
                           text-xs font-semibold"
                >
                    <i class="fas fa-calendar-alt"></i>
                    {{ current_term.name }}
                </span>

            {% endif %}

        </div>


        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">


            <!-- Expected Fees -->
            <div
                class="bg-white
                       rounded-2xl
                       border border-slate-200
                       shadow-sm
                       p-5
                       relative overflow-hidden"
            >

                <div class="flex items-start justify-between">

                    <div
                        class="w-11 h-11 rounded-xl
                               bg-indigo-50
                               text-indigo-600
                               flex items-center justify-center"
                    >
                        <i class="fas fa-file-invoice-dollar text-lg"></i>
                    </div>

                    <span
                        class="text-xs font-medium
                               text-slate-400"
                    >
                        Expected
                    </span>

                </div>

                <p class="text-sm text-slate-500 mt-4">
                    Expected Fees
                </p>

                <p class="text-2xl font-bold text-slate-800 mt-1">
                    {{ total_expected|floatformat:0|intcomma }}
                    <span class="text-sm font-medium text-slate-400">
                        RWF
                    </span>
                </p>

                <p class="text-xs text-slate-400 mt-2">
                    Total fees for this term
                </p>

            </div>


            <!-- Total Paid -->
            <div
                class="bg-white
                       rounded-2xl
                       border border-slate-200
                       shadow-sm
                       p-5"
            >

                <div class="flex items-start justify-between">

                    <div
                        class="w-11 h-11 rounded-xl
                               bg-emerald-50
                               text-emerald-600
                               flex items-center justify-center"
                    >
                        <i class="fas fa-circle-check text-lg"></i>
                    </div>

                    <span
                        class="text-xs font-medium
                               text-emerald-600"
                    >
                        Paid
                    </span>

                </div>

                <p class="text-sm text-slate-500 mt-4">
                    Total Paid
                </p>

                <p class="text-2xl font-bold text-emerald-600 mt-1">
                    {{ total_paid|floatformat:0|intcomma }}
                    <span class="text-sm font-medium text-emerald-400">
                        RWF
                    </span>
                </p>

                <p class="text-xs text-slate-400 mt-2">
                    Valid recorded payments
                </p>

            </div>


            <!-- Balance -->
            <div
                class="bg-white
                       rounded-2xl
                       border border-slate-200
                       shadow-sm
                       p-5"
            >

                <div class="flex items-start justify-between">

                    {% if fee_status == 'PAID' %}

                        <div
                            class="w-11 h-11 rounded-xl
                                   bg-emerald-50
                                   text-emerald-600
                                   flex items-center justify-center"
                        >
                            <i class="fas fa-check text-lg"></i>
                        </div>

                        <span
                            class="text-xs font-semibold
                                   text-emerald-600"
                        >
                            PAID
                        </span>

                    {% elif fee_status == 'CREDIT' %}

                        <div
                            class="w-11 h-11 rounded-xl
                                   bg-blue-50
                                   text-blue-600
                                   flex items-center justify-center"
                        >
                            <i class="fas fa-wallet text-lg"></i>
                        </div>

                        <span
                            class="text-xs font-semibold
                                   text-blue-600"
                        >
                            CREDIT

                        </span>

                    {% elif fee_status == 'PARTIALLY PAID' %}

                        <div
                            class="w-11 h-11 rounded-xl
                                   bg-amber-50
                                   text-amber-600
                                   flex items-center justify-center"
                        >
                            <i class="fas fa-clock text-lg"></i>
                        </div>

                        <span
                            class="text-xs font-semibold
                                   text-amber-600"
                        >
                            PARTIAL
                        </span>

                    {% else %}

                        <div
                            class="w-11 h-11 rounded-xl
                                   bg-slate-100
                                   text-slate-500
                                   flex items-center justify-center"
                        >
                            <i class="fas fa-wallet text-lg"></i>
                        </div>

                        <span
                            class="text-xs font-semibold
                                   text-slate-500"
                        >
                            NO FEES
                        </span>

                    {% endif %}

                </div>


                <p class="text-sm text-slate-500 mt-4">

                    {% if fee_status == 'CREDIT' %}
                        Credit Balance
                    {% else %}
                        Outstanding Balance
                    {% endif %}

                </p>


                <p
                    class="text-2xl font-bold mt-1
                    {% if fee_status == 'PAID' %}
                        text-emerald-600
                    {% elif fee_status == 'CREDIT' %}
                        text-blue-600
                    {% elif fee_status == 'PARTIALLY PAID' %}
                        text-amber-600
                    {% else %}
                        text-slate-600
                    {% endif %}"
                >

                    {{ balance|floatformat:0|intcomma }}

                    <span
                        class="text-sm font-medium
                        {% if fee_status == 'PAID' %}
                            text-emerald-400
                        {% elif fee_status == 'CREDIT' %}
                            text-blue-400
                        {% elif fee_status == 'PARTIALLY PAID' %}
                            text-amber-400
                        {% else %}
                            text-slate-400
                        {% endif %}"
                    >
                        RWF
                    </span>

                </p>


                <p class="text-xs text-slate-400 mt-2">

                    {% if fee_status == 'PAID' %}
                        Your fees are fully paid.
                    {% elif fee_status == 'CREDIT' %}
                        You have a credit balance.
                    {% elif fee_status == 'PARTIALLY PAID' %}
                        Remaining amount for this term.
                    {% else %}
                        No fee balance currently available.
                    {% endif %}

                </p>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- PAYMENT STATUS -->
    <!-- ========================================================= -->

    <section
        class="bg-white
               rounded-2xl
               border border-slate-200
               shadow-sm
               p-5 sm:p-6"
    >

        <div
            class="flex flex-col md:flex-row
                   md:items-center
                   md:justify-between
                   gap-5"
        >

            <!-- Status -->
            <div class="flex items-center gap-4">

                {% if fee_status == 'PAID' %}

                    <div
                        class="w-12 h-12 rounded-xl
                               bg-emerald-50
                               text-emerald-600
                               flex items-center justify-center"
                    >
                        <i class="fas fa-circle-check text-xl"></i>
                    </div>

                {% elif fee_status == 'CREDIT' %}

                    <div
                        class="w-12 h-12 rounded-xl
                               bg-blue-50
                               text-blue-600
                               flex items-center justify-center"
                    >
                        <i class="fas fa-wallet text-xl"></i>
                    </div>

                {% elif fee_status == 'PARTIALLY PAID' %}

                    <div
                        class="w-12 h-12 rounded-xl
                               bg-amber-50
                               text-amber-600
                               flex items-center justify-center"
                    >
                        <i class="fas fa-clock text-xl"></i>
                    </div>

                {% else %}

                    <div
                        class="w-12 h-12 rounded-xl
                               bg-slate-100
                               text-slate-500
                               flex items-center justify-center"
                    >
                        <i class="fas fa-wallet text-xl"></i>
                    </div>

                {% endif %}


                <div>

                    <p
                        class="text-xs uppercase
                               tracking-wider
                               text-slate-400
                               font-semibold"
                    >
                        Current Fee Status
                    </p>

                    <h3
                        class="text-lg font-bold mt-0.5
                        {% if fee_status == 'PAID' %}
                            text-emerald-600
                        {% elif fee_status == 'CREDIT' %}
                            text-blue-600
                        {% elif fee_status == 'PARTIALLY PAID' %}
                            text-amber-600
                        {% else %}
                            text-slate-600
                        {% endif %}"
                    >
                        {{ fee_status }}
                    </h3>

                </div>

            </div>


            <!-- Term -->
            <div
                class="bg-slate-50
                       rounded-xl
                       px-4 py-3
                       border border-slate-100"
            >

                <p class="text-xs text-slate-400">
                    Current Term
                </p>

                <p class="text-sm font-semibold text-slate-700 mt-0.5">
                    {{ current_term.name|default:"Not available" }}
                </p>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- FEE BREAKDOWN -->
    <!-- ========================================================= -->

    <section
        class="bg-white
               rounded-2xl
               border border-slate-200
               shadow-sm
               overflow-hidden"
    >

        <!-- Section Header -->
        <div
            class="px-6 py-5
                   border-b border-slate-100
                   flex flex-col sm:flex-row
                   sm:items-center
                   sm:justify-between
                   gap-3"
        >

            <div>

                <h2 class="text-lg font-bold text-slate-800">
                    Fee Breakdown
                </h2>

                <p class="text-sm text-slate-500 mt-1">
                    Fees assigned to your student account.
                </p>

            </div>


            <span
                class="inline-flex items-center
                       gap-1.5
                       bg-indigo-50
                       text-indigo-700
                       px-3 py-1.5
                       rounded-full
                       text-xs font-semibold
                       self-start"
            >
                <i class="fas fa-file-invoice"></i>
                {{ student_fees|length }}
                Record{{ student_fees|length|pluralize }}
            </span>

        </div>


        {% if student_fees %}

            <!-- Desktop Table -->
            <div class="hidden md:block overflow-x-auto">

                <table class="w-full">

                    <thead>

                        <tr
                            class="bg-slate-50
                                   border-b border-slate-100
                                   text-xs uppercase
                                   tracking-wider
                                   text-slate-500"
                        >

                            <th class="px-6 py-3.5 text-left font-semibold">
                                Academic Year
                            </th>

                            <th class="px-6 py-3.5 text-left font-semibold">
                                Term
                            </th>

                            <th class="px-6 py-3.5 text-right font-semibold">
                                Expected Fees
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-slate-100">

                        {% for fee in student_fees %}

                            <tr
                                class="hover:bg-slate-50
                                       transition"
                            >

                                <td class="px-6 py-4">

                                    <div class="flex items-center gap-3">

                                        <div
                                            class="w-9 h-9 rounded-lg
                                                   bg-indigo-50
                                                   text-indigo-600
                                                   flex items-center
                                                   justify-center"
                                        >
                                            <i class="fas fa-calendar text-sm"></i>
                                        </div>

                                        <span
                                            class="text-sm font-semibold
                                                   text-slate-800"
                                        >
                                            {{ fee.academic_year.name }}
                                        </span>

                                    </div>

                                </td>


                                <td
                                    class="px-6 py-4
                                           text-sm text-slate-600"
                                >
                                    {{ fee.term.name }}
                                </td>


                                <td
                                    class="px-6 py-4
                                           text-right"
                                >

                                    <span
                                        class="text-sm font-bold
                                               text-slate-800"
                                    >
                                        {{ fee.total_expected|floatformat:0|intcomma }}
                                        RWF
                                    </span>

                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>


            <!-- Mobile Fee Cards -->
            <div class="md:hidden divide-y divide-slate-100">

                {% for fee in student_fees %}

                    <div class="p-5">

                        <div class="flex items-center justify-between">

                            <div class="flex items-center gap-3">

                                <div
                                    class="w-10 h-10 rounded-xl
                                           bg-indigo-50
                                           text-indigo-600
                                           flex items-center
                                           justify-center"
                                >
                                    <i class="fas fa-file-invoice"></i>
                                </div>

                                <div>

                                    <p
                                        class="text-sm font-semibold
                                               text-slate-800"
                                    >
                                        {{ fee.term.name }}
                                    </p>

                                    <p
                                        class="text-xs
                                               text-slate-400
                                               mt-0.5"
                                    >
                                        {{ fee.academic_year.name }}
                                    </p>

                                </div>

                            </div>


                            <div class="text-right">

                                <p
                                    class="text-xs
                                           text-slate-400"
                                >
                                    Expected
                                </p>

                                <p
                                    class="text-sm font-bold
                                           text-slate-800
                                           mt-0.5"
                                >
                                    {{ fee.total_expected|floatformat:0|intcomma }}
                                    RWF
                                </p>

                            </div>

                        </div>

                    </div>

                {% endfor %}

            </div>


        {% else %}

            <!-- Empty State -->
            <div class="px-6 py-14 text-center">

                <div
                    class="mx-auto
                           w-14 h-14
                           rounded-full
                           bg-slate-100
                           text-slate-400
                           flex items-center
                           justify-center"
                >
                    <i class="fas fa-file-invoice text-xl"></i>
                </div>

                <h3
                    class="text-sm font-semibold
                           text-slate-700
                           mt-4"
                >
                    No fee structure assigned
                </h3>

                <p
                    class="text-xs text-slate-400
                           mt-1 max-w-sm mx-auto"
                >
                    No fee information has been assigned
                    to your account for this term yet.
                </p>

            </div>

        {% endif %}

    </section>


    <!-- ========================================================= -->
    <!-- PAYMENT HISTORY -->
    <!-- ========================================================= -->

    <section
        class="bg-white
               rounded-2xl
               border border-slate-200
               shadow-sm
               overflow-hidden"
    >

        <!-- Header -->
        <div
            class="px-6 py-5
                   border-b border-slate-100
                   flex flex-col sm:flex-row
                   sm:items-center
                   sm:justify-between
                   gap-3"
        >

            <div>

                <h2 class="text-lg font-bold text-slate-800">
                    Payment History
                </h2>

                <p class="text-sm text-slate-500 mt-1">
                    Recorded payments and available receipts.
                </p>

            </div>


            <span
                class="inline-flex items-center
                       gap-1.5
                       bg-emerald-50
                       text-emerald-700
                       px-3 py-1.5
                       rounded-full
                       text-xs font-semibold
                       self-start"
            >
                <i class="fas fa-receipt"></i>
                {{ payments|length }}
                Payment{{ payments|length|pluralize }}
            </span>

        </div>


        {% if payments %}

            <!-- ================================================= -->
            <!-- DESKTOP PAYMENT TABLE -->
            <!-- ================================================= -->

            <div class="hidden lg:block overflow-x-auto">

                <table class="w-full">

                    <thead>

                        <tr
                            class="bg-slate-50
                                   border-b border-slate-100
                                   text-xs uppercase
                                   tracking-wider
                                   text-slate-500"
                        >

                            <th class="px-6 py-3.5 text-left font-semibold">
                                Receipt
                            </th>

                            <th class="px-4 py-3.5 text-left font-semibold">
                                Date
                            </th>

                            <th class="px-4 py-3.5 text-left font-semibold">
                                Term
                            </th>

                            <th class="px-4 py-3.5 text-left font-semibold">
